#!/usr/bin/env python3

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def sources(*patterns):
    seen = set()
    for pattern in patterns:
        for path in sorted(ROOT.glob(pattern)):
            relative = path.relative_to(ROOT)
            if relative.parts[0].startswith((".", "build")) or relative in seen:
                continue
            seen.add(relative)
            yield relative, path.read_text(encoding="utf-8", errors="replace")


BYTE_ARRAY = re.compile(r'QByteArray\s*\(\s*"((?:[^"\\]|\\.)*)"\s*,\s*(\d+)\s*\)')
SIMPLE_ESCAPES = set('0abtnvfre"\'?\\')


def cpp_literal_body_bytes(text):
    count = 0
    index = 0
    while index < len(text):
        if text[index] != "\\":
            count += len(text[index].encode("utf-8"))
            index += 1
            continue
        index += 1
        if index >= len(text):
            raise ValueError("trailing backslash")
        mark = text[index]
        if mark == "x":
            index += 1
            start = index
            while index < len(text) and text[index] in "0123456789abcdefABCDEF":
                index += 1
            if index == start:
                raise ValueError("empty hex escape")
        elif mark in "01234567":
            digits = 0
            while index < len(text) and text[index] in "01234567" and digits < 3:
                index += 1
                digits += 1
        elif mark in SIMPLE_ESCAPES:
            index += 1
        else:
            raise ValueError(f"unknown escape \\{mark}")
        count += 1
    return count


def check_byte_array_lengths():
    problems = []
    for relative, source in sources("src/**/*.cpp", "src/**/*.h",
                                    "tests/**/*.cpp", "tests/**/*.h"):
        for number, line in enumerate(source.splitlines(), 1):
            for body, declared in BYTE_ARRAY.findall(line):
                try:
                    actual = cpp_literal_body_bytes(body)
                except ValueError as error:
                    problems.append(f"{relative}:{number}: cannot measure literal ({error})")
                    continue
                if actual != int(declared):
                    problems.append(
                        f"{relative}:{number}: QByteArray declares {declared} bytes, "
                        f"the literal is {actual}")
    return problems


def qml_brace_delta(text):
    delta = 0
    index = 0
    length = len(text)
    while index < length:
        char = text[index]
        if char in "\"'":
            quote = char
            index += 1
            while index < length:
                if text[index] == "\\":
                    index += 2
                    continue
                if text[index] == quote:
                    index += 1
                    break
                index += 1
            continue
        if char == "/" and index + 1 < length and text[index + 1] == "/":
            newline = text.find("\n", index)
            index = length if newline < 0 else newline
            continue
        if char == "/" and index + 1 < length and text[index + 1] == "*":
            end = text.find("*/", index + 2)
            index = length if end < 0 else end + 2
            continue
        if char == "/":
            prior = index - 1
            while prior >= 0 and text[prior] in " \t\r\n":
                prior -= 1
            previous = text[prior] if prior >= 0 else ""
            if previous == "" or not (previous.isalnum() or previous in "_)].\""):
                index += 1
                while index < length:
                    if text[index] == "\\":
                        index += 2
                        continue
                    if text[index] == "/":
                        index += 1
                        while index < length and text[index].isalpha():
                            index += 1
                        break
                    if text[index] == "\n":
                        break
                    index += 1
                continue
        if char == "{":
            delta += 1
        elif char == "}":
            delta -= 1
        index += 1
    return delta


def text_blocks(source, type_name="Text"):
    lines = source.splitlines()
    for index, line in enumerate(lines):
        if not re.match(rf"\s*{type_name}\s*\{{\s*$", line):
            continue
        depth = 1
        body = []
        for follower in lines[index + 1:]:
            depth += qml_brace_delta(follower)
            if depth <= 0:
                break
            body.append(follower)
        yield index + 1, "\n".join(body)


def check_qml_text_plain_format():
    problems = []
    for relative, source in sources("src/**/*.qml"):
        for number, body in text_blocks(source):
            if "plainIrcText(" not in body:
                continue
            if "textFormat: Text.PlainText" in body:
                continue
            name = re.search(r'objectName:\s*"([^"]+)"', body)
            label = name.group(1) if name else "unnamed Text"
            problems.append(
                f"{relative}:{number}: {label} renders plainIrcText() without "
                f"textFormat: Text.PlainText")
    return problems


def check_qml_textedit_rich_emphasized():
    problems = []
    for relative, source in sources("src/**/*.qml"):
        for number, body in text_blocks(source, "TextEdit"):
            if "TextEdit.RichText" not in body:
                continue
            if "emphasizedIrcText(" in body:
                continue
            name = re.search(r'objectName:\s*"([^"]+)"', body)
            label = name.group(1) if name else "unnamed TextEdit"
            problems.append(
                f"{relative}:{number}: {label} uses RichText without "
                f"emphasizedIrcText()")
    return problems


def check_message_delegate_body():
    problems = []
    allowed = re.compile(
        r"(?:plainIrcText|emphasizedIrcText|hasIrcEmphasis)\(\s*"
        r"(?:win\.)?messageDelegate\.body")
    raw = re.compile(r"messageDelegate\.body")
    for relative, source in sources("src/**/*.qml"):
        allowed_spans = [(match.start(), match.end()) for match in allowed.finditer(source)]
        for match in raw.finditer(source):
            if any(start <= match.start() and match.end() <= end
                   for start, end in allowed_spans):
                continue
            number = source.count("\n", 0, match.start()) + 1
            problems.append(
                f"{relative}:{number}: raw messageDelegate.body")
    return problems


def check_socket_reads():
    problems = []
    for relative, source in sources("src/singleinstance.cpp", "src/omairccli.cpp"):
        for number, line in enumerate(source.splitlines(), 1):
            if "readAll()" in line:
                problems.append(
                    f"{relative}:{number}: readAll() on an IPC socket reads before "
                    f"the size cap; use read(remaining)")
    return problems


def check_retired_mock_sidebar():
    problems = []
    banned = (
        "liveFallbackSection",
        "preserveLegacyNames",
        "mockOmarchyId",
        "mockOftcId",
    )
    for relative, source in sources("src/**/*.qml", "src/**/*.cpp", "src/**/*.h"):
        for token in banned:
            if token in source:
                problems.append(
                    f"{relative}: {token} is a retired mock sidebar path")
    return problems


def check_hardcoded_chantypes():
    problems = []
    pattern = re.compile(
        r"QLatin1Char\('#'\).{0,80}QLatin1Char\('&'\).{0,80}"
        r"QLatin1Char\('\+'\).{0,80}QLatin1Char\('!'\)",
        re.DOTALL,
    )
    for relative, source in sources("src/**/*.cpp", "src/**/*.h"):
        if relative.name in ("ircserverfeatures.cpp", "ircserverfeatures.h"):
            continue
        if pattern.search(source):
            problems.append(
                f"{relative}: hard-coded CHANTYPES; call IrcServerFeatures")
    return problems


def check_version_source():
    problems = []
    for relative, source in sources("**/*.pro", "**/*.pri"):
        if relative.name == "version.pri":
            continue
        for number, line in enumerate(source.splitlines(), 1):
            if re.match(r"\s*VERSION\s*=", line) or "OMAIRC_VERSION=" in line:
                problems.append(
                    f"{relative}:{number}: set the version in version.pri and "
                    f"include it, do not repeat it here")
    return problems


def check_macos_objc_arc():
    problems = []
    mm = ROOT / "src" / "macosnotifications.mm"
    if not mm.is_file():
        return problems
    text = mm.read_text(encoding="utf-8", errors="replace")
    if "__has_feature(objc_arc)" not in text or "[content release]" not in text:
        problems.append(
            "src/macosnotifications.mm: keep an MRC [content release] gated on "
            "!__has_feature(objc_arc) so notify() cannot leak without ARC")
    for relative, source in sources("**/*.pro"):
        if "macosnotifications.mm" not in source:
            continue
        if "packaging/macos/objc-arc.pri" not in source:
            problems.append(
                f"{relative}: builds macosnotifications.mm without "
                f"packaging/macos/objc-arc.pri (-fobjc-arc)")
    return problems


def check_macos_ci_arch_selection():
    problems = []
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    if not workflow.is_file():
        return problems
    text = workflow.read_text(encoding="utf-8", errors="replace")
    if "qt_aqt_arch=clang_arm64" not in text:
        problems.append(
            ".github/workflows/macos.yml: arm64 runners must prefer aqt "
            "clang_arm64 (install may fall back to universal clang_64)")
    if "EXPECTED_MACHO_ARCH" not in text or "lipo -archs" not in text:
        problems.append(
            ".github/workflows/macos.yml: Smoke must lipo-check the binary "
            "against EXPECTED_MACHO_ARCH so macos-arm64/macos-x64 match")
    arm64_case = text.split("arm64)", 1)
    if len(arm64_case) > 1:
        arm64_body = arm64_case[1].split("x86_64)", 1)[0]
        if "clang_arm64" not in arm64_body:
            problems.append(
                ".github/workflows/macos.yml: arm64 case must prefer "
                "clang_arm64 before any clang_64 fallback")
    if "macos-15-intel" not in text:
        problems.append(
            ".github/workflows/macos.yml: Intel zips must build on macos-15-intel")
    if "suffix: macos-arm64" not in text or "suffix: macos-x64" not in text:
        problems.append(
            ".github/workflows/macos.yml: matrix must include macos-arm64 and "
            "macos-x64 so both architecture zips are artifacts")
    if "omairc-*-macos-*.zip" in text:
        problems.append(
            ".github/workflows/macos.yml: do not glob every macOS zip when "
            "replacing a release asset; that deletes the other architecture")
    if "actions/download-artifact@v4" not in text or "macos-arm64.zip" not in text \
            or "macos-x64.zip" not in text:
        problems.append(
            ".github/workflows/macos.yml: a follow-up job must download both "
            "macos-arm64 and macos-x64 artifacts so a missing zip fails the run")
    return problems


def check_macos_sdk_compat():
    problems = []
    pri = ROOT / "packaging" / "macos" / "sdk-compat.pri"
    if not pri.is_file():
        return ["packaging/macos/sdk-compat.pri: missing SDK compatibility pri"]
    text = pri.read_text(encoding="utf-8", errors="replace")
    if "-include arm_acle.h" not in text:
        problems.append(
            "packaging/macos/sdk-compat.pri: Apple Silicon still needs "
            "-include arm_acle.h for Qt 6.8 qyieldcpu.h on Xcode 26")
    if "equals(QMAKE_HOST.arch, arm64)" not in text:
        problems.append(
            "packaging/macos/sdk-compat.pri: -include arm_acle.h must be gated "
            "to Apple Silicon; Intel fails with ACLE not enabled")
    for relative, source in sources("**/*.pro"):
        if "-include arm_acle.h" not in source:
            continue
        if "equals(QMAKE_HOST.arch, arm64)" in source:
            continue
        problems.append(
            f"{relative}: -include arm_acle.h must go through "
            "packaging/macos/sdk-compat.pri so Intel builds skip it")
    return problems


CHECKS = (
    ("QByteArray literal lengths", check_byte_array_lengths),
    ("PlainText on server-controlled QML text", check_qml_text_plain_format),
    ("RichText through emphasizedIrcText", check_qml_textedit_rich_emphasized),
    ("formatted messageDelegate.body", check_message_delegate_body),
    ("bounded IPC socket reads", check_socket_reads),
    ("single version source", check_version_source),
    ("CHANTYPES via IrcServerFeatures", check_hardcoded_chantypes),
    ("retired mock sidebar tokens", check_retired_mock_sidebar),
    ("macOS ObjC ARC for notifications", check_macos_objc_arc),
    ("macOS CI Qt arch selection", check_macos_ci_arch_selection),
    ("macOS SDK compat arch gate", check_macos_sdk_compat),
)


def main():
    failed = False
    for title, check in CHECKS:
        problems = check()
        if problems:
            failed = True
            print(f"{title}:", file=sys.stderr)
            for problem in problems:
                print(f"  {problem}", file=sys.stderr)
    if failed:
        return 1
    print(f"conventions: {len(CHECKS)} checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
