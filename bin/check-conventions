#!/usr/bin/env python3

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def sources(*patterns):
    seen = set()
    for pattern in patterns:
        for path in sorted(ROOT.glob(pattern)):
            relative = path.relative_to(ROOT)
            if relative.parts[0].startswith((".", "build")) or relative in seen:
                continue
            seen.add(relative)
            yield relative, path.read_text(encoding="utf-8", errors="replace")


VERSION_PRI = ROOT / "version.pri"
FEATURE_MAP_DIR = ROOT / ".cursor" / "skills" / "verify-omairc" / "features"


def _read_text(path):
    if not path.is_file():
        return None
    return path.read_text(encoding="utf-8", errors="replace")


def _require_file(path, label, problems):
    if not path.is_file():
        problems.append(f"{label}: missing {path.relative_to(ROOT).as_posix()}")


def _require_symbol(path, symbol, label, problems):
    text = _read_text(path)
    if text is None:
        return
    if symbol not in text:
        problems.append(
            f"{label}: expected {symbol!r} in {path.relative_to(ROOT).as_posix()}")


def check_version_source():
    problems = []
    text = _read_text(VERSION_PRI)
    if text is None:
        return ["version.pri: missing single VERSION source"]
    if not re.search(r"^\s*VERSION\s*=", text, re.M):
        problems.append("version.pri: must set VERSION")
    for relative, source in sources("**/*.pro", "**/*.pri", "CMakeLists.txt"):
        if relative.name == "version.pri":
            continue
        for number, line in enumerate(source.splitlines(), 1):
            if re.match(r"\s*VERSION\s*=", line) or "OMAIRC_VERSION=" in line:
                problems.append(
                    f"{relative}:{number}: set the version in version.pri only, "
                    f"do not repeat it here")
    return problems


def _version_pri_value(text):
    match = re.search(r"^\s*VERSION\s*=\s*(\S+)\s*$", text, re.M)
    if not match:
        return None
    return match.group(1)


def version_pri_to_cargo_semver(version):
    """Arch pkgver cannot contain hyphens, so letter suffixes sit flush
    (`1.0.7alpha`). Cargo SemVer needs a pre-release separator (`1.0.7-alpha`).

    Keep identical to client/src/version_pri.rs::to_cargo_semver. Double dots,
    a letter after a bare dot, or a non-letter after the numeric prefix do not
    convert.
    """
    match = re.match(r"^(\d+(?:\.\d+)*)([A-Za-z].*)$", version)
    if match:
        return f"{match.group(1)}-{match.group(2)}"
    return version


# Shared with client/src/version_pri.rs tests (same raw -> want pairs).
VERSION_PRI_TO_CARGO_CASES = (
    ("1.0.7alpha", "1.0.7-alpha"),
    ("1.10.3", "1.10.3"),
    ("2.0.0beta1", "2.0.0-beta1"),
    ("1.0.7rc2", "1.0.7-rc2"),
    ("1alpha", "1-alpha"),
    ("1.0a2", "1.0-a2"),
    ("1.2.3.4rc1", "1.2.3.4-rc1"),
    ("1..2alpha", "1..2alpha"),
    ("..1alpha", "..1alpha"),
    ("1.0.7.alpha", "1.0.7.alpha"),
    ("1.0.7-alpha", "1.0.7-alpha"),
    ("1.0.7+build", "1.0.7+build"),
)


def _self_test_version_pri_to_cargo_semver():
    for raw, want in VERSION_PRI_TO_CARGO_CASES:
        got = version_pri_to_cargo_semver(raw)
        if got != want:
            raise AssertionError(
                f"version_pri_to_cargo_semver({raw!r}) = {got!r}, want {want!r}")


def _cargo_toml_package_version(text):
    match = re.search(r"^\[package\]\s*$", text, re.M)
    if not match:
        return None
    rest = text[match.end():]
    next_header = re.search(r"^\[", rest, re.M)
    table = rest[:next_header.start()] if next_header else rest
    ver = re.search(r'^\s*version\s*=\s*"([^"]+)"\s*$', table, re.M)
    if not ver:
        return None
    return ver.group(1)


def _cargo_lock_omairc_version(text):
    for block in re.split(r"^\[\[package\]\]\s*$", text, flags=re.M):
        if not re.search(r'^\s*name\s*=\s*"omairc"\s*$', block, re.M):
            continue
        ver = re.search(r'^\s*version\s*=\s*"([^"]+)"\s*$', block, re.M)
        if not ver:
            return None
        return ver.group(1)
    return None


def check_cargo_version_matches_version_pri():
    problems = []
    try:
        _self_test_version_pri_to_cargo_semver()
    except AssertionError as exc:
        return [f"version_pri_to_cargo_semver self-test failed: {exc}"]

    pri_text = _read_text(VERSION_PRI)
    cargo_toml_path = ROOT / "client" / "Cargo.toml"
    cargo_lock_path = ROOT / "client" / "Cargo.lock"
    cargo_toml_text = _read_text(cargo_toml_path)
    cargo_lock_text = _read_text(cargo_lock_path)

    pri_raw = _version_pri_value(pri_text) if pri_text is not None else None
    pri_cargo = (
        version_pri_to_cargo_semver(pri_raw) if pri_raw is not None else None)
    toml_ver = (
        _cargo_toml_package_version(cargo_toml_text)
        if cargo_toml_text is not None else None)
    lock_ver = (
        _cargo_lock_omairc_version(cargo_lock_text)
        if cargo_lock_text is not None else None)

    if pri_text is None:
        problems.append("version.pri: missing")
    elif pri_raw is None:
        problems.append("version.pri: missing VERSION value")
    if cargo_toml_text is None:
        problems.append("client/Cargo.toml: missing")
    elif toml_ver is None:
        problems.append("client/Cargo.toml: missing [package] version")
    if cargo_lock_text is None:
        problems.append("client/Cargo.lock: missing")
    elif lock_ver is None:
        problems.append('client/Cargo.lock: missing [[package]] name = "omairc" version')

    if problems:
        return problems

    if toml_ver != pri_cargo or lock_ver != pri_cargo:
        problems.append(
            f"expected Cargo {pri_cargo} (from version.pri {pri_raw}); "
            f"Cargo.toml={toml_ver}; Cargo.lock={lock_ver}")
    return problems


def check_client_crate():
    problems = []
    cargo = ROOT / "client" / "Cargo.toml"
    text = _read_text(cargo)
    if text is None:
        return ["client/Cargo.toml: product crate must live at client/"]
    if not re.search(r'^\s*name\s*=\s*"omairc"\s*$', text, re.M):
        problems.append('client/Cargo.toml: package name must be "omairc"')
    if not re.search(r'^\s*default\s*=\s*\[\s*"product"\s*\]', text, re.M):
        problems.append(
            "client/Cargo.toml: default features must include product")
    if not re.search(r"^\s*dev\s*=\s*\[\s*\]", text, re.M):
        problems.append("client/Cargo.toml: must declare a dev feature")
    return problems


def check_shared_irc_contract():
    problems = []
    rust_conversation = ROOT / "client" / "src" / "irc" / "conversation.rs"
    go_conversation = ROOT / "tui" / "internal" / "irc" / "conversation.go"
    rust_features = ROOT / "client" / "src" / "irc" / "serverfeatures.rs"
    go_features = ROOT / "tui" / "internal" / "irc" / "serverfeatures.go"
    rust_secret = ROOT / "client" / "src" / "irc" / "secretpolicy.rs"
    go_secret = ROOT / "tui" / "internal" / "irc" / "secretpolicy.go"
    rust_reducer = ROOT / "client" / "src" / "irc" / "reducer" / "conversations.rs"
    go_reducer = ROOT / "tui" / "internal" / "irc" / "reducer.go"

    for path, label in (
        (rust_conversation, "IrcConversationCause"),
        (go_conversation, "ConversationCauseInserts"),
        (rust_features, "IrcServerFeatures"),
        (go_features, "ServerFeatures"),
        (rust_secret, "IrcSecretPolicy"),
        (go_secret, "secret policy"),
        (rust_reducer, "ordered_members"),
        (go_reducer, "OrderedMembers"),
    ):
        _require_file(path, label, problems)

    _require_symbol(rust_conversation, "impl IrcConversationCause", "IrcConversationCause", problems)
    _require_symbol(rust_conversation, "fn inserts", "IrcConversationCause::inserts", problems)
    _require_symbol(go_conversation, "func ConversationCauseInserts", "ConversationCauseInserts", problems)
    _require_symbol(rust_features, "pub struct IrcServerFeatures", "IrcServerFeatures", problems)
    _require_symbol(go_features, "type ServerFeatures struct", "ServerFeatures", problems)
    _require_symbol(rust_secret, "pub fn allows_transcript", "IrcSecretPolicy", problems)
    _require_symbol(rust_secret, "pub fn redact_preview_line", "IrcSecretPolicy", problems)
    _require_symbol(go_secret, "func AllowsTranscript", "secret policy", problems)
    _require_symbol(go_secret, "func RedactPreviewLine", "secret policy", problems)
    _require_symbol(rust_reducer, "pub fn ordered_members", "ordered_members", problems)
    _require_symbol(go_reducer, "func (r *EventReducer) OrderedMembers", "OrderedMembers", problems)

    if not FEATURE_MAP_DIR.is_dir():
        problems.append(
            ".cursor/skills/verify-omairc/features: missing shared feature map directory")
    else:
        feature_docs = [
            path for path in FEATURE_MAP_DIR.glob("*.md")
            if path.name.lower() != "readme.md"
        ]
        if not feature_docs:
            problems.append(
                ".cursor/skills/verify-omairc/features: need at least one .md "
                "besides README")
    return problems


# A version-looking string literal: major.minor with an optional patch and an
# optional letter or -/+ suffix (1.0.4, 1.0.4alpha, 1.0.4+main.g1). The
# trailing negative lookahead rejects a further dotted group so an IP address
# like 127.0.0.1 is not mistaken for a version.
GO_VERSION_STRING = (
    r'"(?P<number>v?[0-9]+\.[0-9]+(?:\.[0-9]+)?'
    r'(?:[A-Za-z][0-9A-Za-z]*|[-+][0-9A-Za-z.\-]+)?)'
    r'(?![0-9A-Za-z.\-])"'
)
GO_VERSION_DECL = re.compile(r"\b(?:const|var)\b[^\n=]*=\s*" + GO_VERSION_STRING)
GO_VERSION_BLOCK_DECL = re.compile(
    r"^\s*[A-Za-z_][A-Za-z0-9_]*\s*=\s*" + GO_VERSION_STRING + r"\s*(?://.*)?$")
GO_VERSION_BLOCK_OPEN = re.compile(r"\b(?:const|var)\s*\(")
GO_VERSION_BLOCK_CLOSE = re.compile(r"^\s*\)\s*$")
GO_VERSION_SOURCE = Path("tui/internal/version/version.go")


def check_go_version_source():
    problems = []
    for relative, source in sources("tui/**/*.go"):
        if Path(relative) == GO_VERSION_SOURCE:
            continue
        in_block = False
        for number, line in enumerate(source.splitlines(), 1):
            if GO_VERSION_BLOCK_OPEN.search(line):
                in_block = True
            if in_block and GO_VERSION_BLOCK_CLOSE.match(line):
                in_block = False
                continue
            match = GO_VERSION_DECL.search(line)
            if not match and in_block:
                match = GO_VERSION_BLOCK_DECL.search(line)
            if not match:
                continue
            problems.append(
                f"{relative}:{number}: hard-coded version "
                f"{match.group('number')!r}; read internal/version.Value "
                f"(injected from version.pri) instead")
    return problems


def check_go_build_uses_version_pri():
    problems = []
    build = ROOT / "tui" / "bin" / "build"
    if not build.is_file():
        return ["tui/bin/build: missing; omairc-tui must build through it so "
                "version.Value is injected"]
    text = build.read_text(encoding="utf-8", errors="replace")
    if "bin/version" not in text:
        problems.append(
            "tui/bin/build: read the version from bin/version, not a second "
            "source")
    if "internal/version.Value" not in text:
        problems.append(
            "tui/bin/build: inject internal/version.Value so Go has one "
            "version source")
    if "-ldflags" not in text:
        problems.append(
            "tui/bin/build: inject version.Value through -ldflags")
    if "GOTOOLCHAIN=local" not in text:
        problems.append(
            "tui/bin/build: pin GOTOOLCHAIN=local like packaging/tui/PKGBUILD")
    return problems


GO_PLATFORM_IMPORTS = ("net", "os", "crypto/tls")

# A Go import target. The alias is optional and may be a bare identifier, a
# dot alias, or a blank alias; the path is quoted and a trailing `// comment`
# is allowed. One pattern covers a single-line `import ...` and a member of a
# parenthesized block alike.
GO_IMPORT_LINE = re.compile(
    r'^\s*(?:import\s+)?(?:[A-Za-z_.][A-Za-z0-9_.]*\s+)?'
    r'"([^"]+)"\s*(?://.*)?$')
GO_IMPORT_BLOCK_OPEN = re.compile(r'^\s*import\s*\(\s*(?://.*)?$')
GO_IMPORT_BLOCK_CLOSE = re.compile(r'^\s*\)\s*(?://.*)?$')


def go_imports(source):
    """Yield (line_number, import_path) for every Go import in source text.

    Handles single-line imports (`import "p"`, `import alias "p"`,
    `import . "p"`, `import _ "p"`) and parenthesized blocks, including
    aliases, dot/blank aliases, blank lines, and trailing `// comments`.
    Outside a block an `import` keyword is required so a statement such as
    `return "yes"` is not mistaken for an import.
    """
    in_block = False
    for number, line in enumerate(source.splitlines(), 1):
        if in_block:
            if GO_IMPORT_BLOCK_CLOSE.match(line):
                in_block = False
                continue
        else:
            if GO_IMPORT_BLOCK_OPEN.match(line):
                in_block = True
                continue
            if not line.lstrip().startswith("import"):
                continue
        match = GO_IMPORT_LINE.match(line)
        if match:
            yield number, match.group(1)


# URL and IP-literal parsing are pure functions, not a socket or TLS stack.
# avatarurl.go mirrors client/src/irc/avatarurl.rs (URL + IP literals), so it
# needs net/url and net/netip. filelink.go mirrors client/src/irc/filelink.rs.
# Every other internal/irc file stays fully neutral.
GO_IRC_PLATFORM_NEUTRAL_EXEMPT = {
    "tui/internal/irc/avatarurl.go": {"net/url", "net/netip"},
    "tui/internal/irc/filelink.go": {"net/url"},
}


def check_go_irc_platform_neutrality():
    # internal/irc is the portable core: sockets, clocks, the filesystem, and
    # TLS belong in internal/session. Test files may read testdata with os.
    problems = []
    for relative, source in sources("tui/internal/irc/*.go"):
        if relative.name.endswith("_test.go"):
            continue
        exempt = GO_IRC_PLATFORM_NEUTRAL_EXEMPT.get(
            Path(relative).as_posix(), set())
        for number, imported in go_imports(source):
            if imported in exempt:
                continue
            if imported in GO_PLATFORM_IMPORTS or imported.startswith("net/"):
                problems.append(
                    f"{relative}:{number}: internal/irc must stay platform "
                    f"neutral; {imported!r} belongs in internal/session")
    return problems


GO_INTERNAL_IRC_IMPORT = "github.com/fredimachado/omairc/tui/internal/irc"
GO_VIEW_PACKAGES = (
    ("tui/internal/ui/*.go", "internal/ui"),
    ("tui/internal/gate/*.go", "internal/gate"),
)


def check_go_view_no_protocol():
    # The view and the parity driver read controller snapshots and plain
    # strings; protocol policy belongs in internal/controller. Test files may
    # import what they assert against.
    problems = []
    for pattern, package in GO_VIEW_PACKAGES:
        for relative, source in sources(pattern):
            if relative.name.endswith("_test.go"):
                continue
            for number, imported in go_imports(source):
                if imported == GO_INTERNAL_IRC_IMPORT:
                    problems.append(
                        f"{relative}:{number}: {package} must not import "
                        f"internal/irc protocol policy; read controller "
                        f"snapshots instead")
    return problems


GO_TITLE_STRINGS = ("- Omairc", '" Status"')
GO_TITLE_SOURCE = Path("tui/internal/ui/title.go")


def check_go_title_strings():
    # Window-title literals live only in title.go so the TUI shell has one
    # place to change them. Tests may assert titles.
    problems = []
    for relative, source in sources("tui/**/*.go"):
        if Path(relative) == GO_TITLE_SOURCE or relative.name.endswith("_test.go"):
            continue
        for number, line in enumerate(source.splitlines(), 1):
            for literal in GO_TITLE_STRINGS:
                if literal in line:
                    problems.append(
                        f"{relative}:{number}: the window title literal "
                        f"{literal!r} belongs only in tui/internal/ui/title.go")
    return problems


def check_macos_ci_bash32():
    problems = []
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    if not workflow.is_file():
        return problems
    for number, line in enumerate(
            workflow.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        code = line.split("#", 1)[0]
        if re.search(r"\b(mapfile|readarray)\b", code):
            problems.append(
                f".github/workflows/macos.yml:{number}: macOS /bin/bash is 3.2; "
                "do not use mapfile/readarray (Bash 4+)")
    return problems


def check_macos_notarization():
    problems = []
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    sign = ROOT / "bin" / "sign-macos"
    notarize = ROOT / "bin" / "notarize-macos"
    entitlements = ROOT / "packaging" / "macos" / "Omairc.entitlements"
    if not workflow.is_file():
        return problems
    text = workflow.read_text(encoding="utf-8", errors="replace")
    notarize_text = notarize.read_text(encoding="utf-8", errors="replace") if notarize.is_file() else ""
    if "APPLE_CERTIFICATE" not in text or "OMAIRC_REQUIRE_DEVELOPER_ID" not in text:
        problems.append(
            ".github/workflows/macos.yml: import a Developer ID certificate and "
            "set OMAIRC_REQUIRE_DEVELOPER_ID so signed CI builds cannot silently "
            "fall back to ad-hoc")
    if "Tag releases require APPLE_CERTIFICATE" not in text:
        problems.append(
            ".github/workflows/macos.yml: v* tags must fail closed without "
            "APPLE_CERTIFICATE rather than shipping an ad-hoc zip")
    if "notarytool" not in notarize_text:
        problems.append(
            "bin/notarize-macos: notarize Developer ID zips with notarytool")
    if "bin/notarize-macos" not in text:
        problems.append(
            ".github/workflows/macos.yml: notarize release zips through "
            "bin/notarize-macos, not on every pull request")
    if "CODESIGN_IDENTITY" not in sign.read_text(encoding="utf-8", errors="replace"):
        problems.append(
            "bin/sign-macos: Developer ID sign when CODESIGN_IDENTITY is set")
    if "com.apple.security.cs.allow-jit" not in entitlements.read_text(
            encoding="utf-8", errors="replace"):
        problems.append(
            "packaging/macos/Omairc.entitlements: hardened runtime must allow "
            "runtime JIT")
    if "disable-library-validation" in entitlements.read_text(
            encoding="utf-8", errors="replace"):
        problems.append(
            "packaging/macos/Omairc.entitlements: leave library validation on; "
            "Disable Library Validation makes Gatekeeper reject dangling "
            "LC_RPATH / LC_LOAD_DYLIB paths after a quarantined download")
    build_rust = ROOT / "bin" / "build-macos-rust"
    build_text = _read_text(build_rust) or ""
    if not build_rust.is_file():
        problems.append("bin/build-macos-rust: missing Rust macOS product build")
    else:
        if "bin/sign-macos" not in build_text:
            problems.append("bin/build-macos-rust: sign through bin/sign-macos")
        if "bin/check-macos-bundle" not in build_text:
            problems.append(
                "bin/build-macos-rust: validate the bundle through "
                "bin/check-macos-bundle")
    if "bin/check-macos-bundle" not in text:
        problems.append(
            ".github/workflows/macos.yml: call bin/check-macos-bundle after "
            "Developer ID signing")
    if "bin/check-macos-syspolicy notary-submission" not in text:
        problems.append(
            ".github/workflows/macos.yml: syspolicy_check notary-submission "
            "after Developer ID signing (catches dangling load commands "
            "spctl misses without quarantine)")
    if "bin/check-macos-syspolicy distribution" not in text:
        problems.append(
            ".github/workflows/macos.yml: syspolicy_check distribution after "
            "stapling, before publishing the zip")
    syspolicy = ROOT / "bin" / "check-macos-syspolicy"
    if not syspolicy.is_file():
        problems.append("bin/check-macos-syspolicy: wrap syspolicy_check")
    else:
        syspolicy_text = syspolicy.read_text(encoding="utf-8", errors="replace")
        if "syspolicy_check" not in syspolicy_text:
            problems.append(
                "bin/check-macos-syspolicy: call syspolicy_check notary-submission "
                "and distribution")
        if "Internal Xprotect Error" not in syspolicy_text:
            problems.append(
                "bin/check-macos-syspolicy: ignore Internal Xprotect Error on "
                "GitHub-hosted runners; codesign and Apple notarization are "
                "the malware gate")
    if re.search(
            r"codesign --force --deep --options runtime",
            sign.read_text(encoding="utf-8", errors="replace")):
        problems.append(
            "bin/sign-macos: do not codesign --deep for Developer ID; sign "
            "nested Mach-O inside-out, then the bundle with entitlements")
    if "codesign --verify" not in text:
        problems.append(
            ".github/workflows/macos.yml: keep codesign --verify after Developer ID "
            "signing")
    if "stapler validate" not in text:
        problems.append(
            ".github/workflows/macos.yml: keep stapler validate after notarization")
    if "spctl --assess --type execute --verbose=4" not in text:
        problems.append(
            ".github/workflows/macos.yml: after stapling, assess Gatekeeper with "
            "spctl --assess --type execute --verbose=4 so a rejected app fails "
            "the release")
    if re.search(r"\bspctl\b", text) and "OMAIRC_NOTARIZED" not in text:
        problems.append(
            ".github/workflows/macos.yml: Gatekeeper assessment must run only after "
            "successful notarization (OMAIRC_NOTARIZED)")
    combined = text + "\n" + notarize_text
    if re.search(r"(--apple-id|\bAPPLE_ID\b|\bAPP_PASSWORD\b)", combined):
        problems.append(
            "macOS notarization must use the App Store Connect API key, not "
            "Apple ID / app-password")
    if re.search(r"com\.apple\.quarantine|\bxattr\b", combined):
        problems.append(
            "do not strip quarantine to bypass Gatekeeper; assess the stapled app")
    if re.search(r"(?i)\bsparkle\b", combined):
        problems.append("do not add Sparkle to macOS CI or notarization")
    return problems


def check_macos_ci_arch_selection():
    problems = []
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    if not workflow.is_file():
        return problems
    text = workflow.read_text(encoding="utf-8", errors="replace")
    if "EXPECTED_MACHO_ARCH" not in text or "lipo -archs" not in text:
        problems.append(
            ".github/workflows/macos.yml: Smoke must lipo-check the binary "
            "against EXPECTED_MACHO_ARCH so macos-arm64/macos-x64 match")
    host_arch_match = re.search(
        r"(?m)^      - name: Select host arch\n(?:.*\n)*?(?=^      - name: |\Z)",
        text,
    )
    if not host_arch_match:
        problems.append(
            ".github/workflows/macos.yml: missing step 'Select host arch' "
            "for the Rust product job")
    else:
        host_arch = host_arch_match.group(0)
        if "expected_macho_arch=arm64" not in host_arch \
                or "expected_macho_arch=x86_64" not in host_arch:
            problems.append(
                ".github/workflows/macos.yml: Select host arch must set "
                "expected_macho_arch for arm64 and x86_64 runners")
    if "macos-15-intel" not in text:
        problems.append(
            ".github/workflows/macos.yml: Intel zips must build on macos-15-intel")
    if not re.search(r"(?m)^\s+- os: macos-15$", text):
        problems.append(
            ".github/workflows/macos.yml: Apple Silicon zips must build on macos-15; "
            "macos-latest is macOS 26 and does not ship Xcode 16")
    if "suffix: macos-arm64" not in text or "suffix: macos-x64" not in text:
        problems.append(
            ".github/workflows/macos.yml: matrix must include macos-arm64 and "
            "macos-x64 so both architecture zips are artifacts")
    if "omairc-*-macos-*.zip" in text:
        problems.append(
            ".github/workflows/macos.yml: do not glob every macOS zip when "
            "replacing a release asset; that deletes the other architecture")
    if "actions/download-artifact@v8" not in text or "macos-arm64.zip" not in text \
            or "macos-x64.zip" not in text:
        problems.append(
            ".github/workflows/macos.yml: a follow-up job must download both "
            "macos-arm64 and macos-x64 artifacts so a missing zip fails the run")
    return problems


def _named_step_header(text, name):
    match = re.search(
        rf"(?m)^      - name: {re.escape(name)}\n((?:        .+\n){{0,8}})",
        text,
    )
    return match.group(0) if match else ""


def check_ci_package_triggers():
    problems = []
    windows = ROOT / ".github" / "workflows" / "windows.yml"
    macos = ROOT / ".github" / "workflows" / "macos.yml"
    release = ROOT / ".github" / "workflows" / "release-package.yml"
    windows_text = windows.read_text(encoding="utf-8", errors="replace") \
        if windows.is_file() else ""
    macos_text = macos.read_text(encoding="utf-8", errors="replace") \
        if macos.is_file() else ""
    release_text = release.read_text(encoding="utf-8", errors="replace") \
        if release.is_file() else ""

    if not windows.is_file():
        problems.append(".github/workflows/windows.yml: missing Windows workflow")
    if not macos.is_file():
        problems.append(".github/workflows/macos.yml: missing macOS workflow")
    if not release.is_file():
        problems.append(
            ".github/workflows/release-package.yml: missing Arch package workflow")

    package_if = (
        "if: github.event_name == 'workflow_dispatch' || "
        "startsWith(github.ref, 'refs/tags/v')"
    )
    # Rust owns tag/dispatch release artifacts.
    for relative, text, names in (
        (".github/workflows/windows.yml", windows_text, (
            "Upload rust installer",
        )),
        (".github/workflows/macos.yml", macos_text, (
            "Upload app zip",
            "Download architecture zips",
            "Assert both architecture zips",
        )),
    ):
        for name in names:
            header = _named_step_header(text, name)
            if not header:
                problems.append(f"{relative}: missing step {name!r}")
                continue
            if package_if not in header:
                problems.append(
                    f"{relative}: {name} must package only on workflow_dispatch "
                    "and v* tags; pull requests and main skip artifacts")
    if "Publish GitHub Release asset" not in windows_text:
        problems.append(
            ".github/workflows/windows.yml: rust job must publish the setup "
            "and zip to the GitHub Release on v* tags")
    if "Package rust release zip" not in windows_text:
        problems.append(
            ".github/workflows/windows.yml: rust job must build "
            "omairc-<v>-windows-x64.zip for the GitHub Release")
    if "cargo test --locked" not in macos_text:
        problems.append(
            ".github/workflows/macos.yml: rust job must run cargo test --locked")

    skip = _named_step_header(macos_text, "Skip zip artifacts")
    if not skip:
        problems.append(
            ".github/workflows/macos.yml: Both macOS zips must stay a green "
            "no-op when this run does not package, so a skipped download is "
            "not a failed check")
    elif "workflow_dispatch" not in skip or "refs/tags/v" not in skip:
        problems.append(
            ".github/workflows/macos.yml: Skip zip artifacts must no-op on "
            "pull requests and main, not only pull requests")

    if re.search(r"(?m)^  push:\n    branches:\n      - main\b", release_text):
        problems.append(
            ".github/workflows/release-package.yml: do not package on main "
            "pushes; keep v* tags and workflow_dispatch")

    tui = ROOT / ".github" / "workflows" / "tui.yml"
    tui_text = tui.read_text(encoding="utf-8", errors="replace") \
        if tui.is_file() else ""
    if not tui.is_file():
        problems.append(".github/workflows/tui.yml: missing TUI workflow")
    else:
        for name in ("Package static archives", "Upload static archives"):
            header = _named_step_header(tui_text, name)
            if not header:
                problems.append(f".github/workflows/tui.yml: missing step {name!r}")
                continue
            if package_if not in header:
                problems.append(
                    f".github/workflows/tui.yml: {name} must package only on "
                    "workflow_dispatch and v* tags; pull requests and main "
                    "skip artifacts")
        if "package-macos" in tui_text:
            problems.append(
                ".github/workflows/tui.yml: release jobs must not call "
                "tui/bin/package-macos")
        if "cancel-in-progress: ${{ !startsWith(github.ref, 'refs/tags/') }}" \
                not in tui_text:
            problems.append(
                ".github/workflows/tui.yml: tag concurrency must not cancel "
                "an in-progress release")
        if len(re.findall(r"(?m)^\s+contents: write\s*$", tui_text)) != 2:
            problems.append(
                ".github/workflows/tui.yml: contents: write belongs on the "
                "package and bump jobs only")
        if "bin/bump-homebrew-cask" in tui_text or "Casks/omairc.rb" in tui_text:
            problems.append(
                ".github/workflows/tui.yml: the TUI bump must not touch "
                "Casks/omairc.rb")
        if "bin/bump-homebrew-tui" not in tui_text or "bin/bump-scoop-tui" not in tui_text:
            problems.append(
                ".github/workflows/tui.yml: version tags must run "
                "bin/bump-homebrew-tui and bin/bump-scoop-tui")
        if "git fetch origin main" not in tui_text \
                or "git rebase origin/main" not in tui_text \
                or "max_attempts=5" not in tui_text:
            problems.append(
                ".github/workflows/tui.yml: manifest bump must fetch and "
                "rebase onto origin/main, retrying a raced push")
        if "packaging/tui/PKGBUILD" not in tui_text or "makepkg" not in tui_text:
            problems.append(
                ".github/workflows/tui.yml: dry-build packaging/tui/PKGBUILD "
                "on pull requests; release-package.yml's tag job must not be "
                "its first build")
        if "if: ${{ !startsWith(github.ref, 'refs/tags/v') }}" not in tui_text:
            problems.append(
                ".github/workflows/tui.yml: the packaging/tui/PKGBUILD dry "
                "build must skip tags; release-package.yml builds the package "
                "there")

    test_wf = ROOT / ".github" / "workflows" / "test.yml"
    test_text = test_wf.read_text(encoding="utf-8", errors="replace") \
        if test_wf.is_file() else ""
    if not test_wf.is_file():
        problems.append(".github/workflows/test.yml: missing Test workflow")
    else:
        if "makepkg" not in test_text or not re.search(
                r"(?m)^  arch-package:\s*$", test_text,
        ):
            problems.append(
                ".github/workflows/test.yml: dry-build PKGBUILD "
                "on pull requests; release-package.yml's tag job must not be "
                "its first build")
        if "if: ${{ !startsWith(github.ref, 'refs/tags/v') }}" not in test_text:
            problems.append(
                ".github/workflows/test.yml: the PKGBUILD dry "
                "build must skip tags; release-package.yml builds the package "
                "there")
    return problems


def check_macos_ci_xcode_and_actions():
    problems = []
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    if not workflow.is_file():
        return problems
    text = workflow.read_text(encoding="utf-8", errors="replace")
    if "maxim-lobanov/setup-xcode@v1" not in text or "xcode-version:" not in text:
        problems.append(
            ".github/workflows/macos.yml: select Xcode with maxim-lobanov/setup-xcode "
            "and an exact xcode-version; do not fall back to the runner default")
    if "No Xcode 16 install found" in text or "Prefer Xcode 16 when available" in text:
        problems.append(
            ".github/workflows/macos.yml: do not keep a best-effort Xcode 16 "
            "shell fallback; setup-xcode must fail closed")
    versions = re.findall(r"xcode-version:\s*['\"]?([^\s'\"}]+)", text)
    versions += re.findall(r'(?m)^\s+xcode:\s*"([^"]+)"', text)
    concrete = [version for version in versions if not version.startswith("${{")]
    if not concrete:
        problems.append(
            ".github/workflows/macos.yml: pin an exact Xcode 16 release in "
            "xcode-version or the matrix xcode field")
    for version in concrete:
        if not re.fullmatch(r"16\.\d+", version):
            problems.append(
                ".github/workflows/macos.yml: Xcode pin must be an exact 16.x "
                f"release, not {version!r}")
    required = (
        ("actions/checkout@v7", "actions/checkout@v7"),
        ("actions/upload-artifact@v7", "actions/upload-artifact@v7"),
        ("actions/download-artifact@v8", "actions/download-artifact@v8"),
    )
    for needle, label in required:
        if needle not in text:
            problems.append(
                f".github/workflows/macos.yml: use {label} (current Node 24 major)")
    if "Swatinem/rust-cache@v2" not in text and "actions/cache@v6" not in text:
        problems.append(
            ".github/workflows/macos.yml: cache the Rust client with "
            "Swatinem/rust-cache@v2 or actions/cache@v6")
    stale = (
        r"actions/checkout@v[1-6]\b",
        r"actions/cache@v[1-5]\b",
        r"actions/upload-artifact@v[1-6]\b",
        r"actions/download-artifact@v[1-7]\b",
    )
    for pattern in stale:
        if re.search(pattern, text):
            problems.append(
                f".github/workflows/macos.yml: replace stale action pin matching "
                f"{pattern}")
    if "contents: write" not in text:
        problems.append(
            ".github/workflows/macos.yml: keep contents: write for release assets")
    if re.search(r"(id-token|pages|pull-requests):\s*write", text):
        problems.append(
            ".github/workflows/macos.yml: do not broaden workflow permissions "
            "beyond contents: write")
    return problems


def macos_readme_section(text):
    start = text.find("## macOS")
    if start < 0:
        return ""
    rest = text[start + 2:]
    next_heading = rest.find("\n## ")
    if next_heading < 0:
        return text[start:]
    return text[start:start + 2 + next_heading]


def _omairc_star_globs(text):
    """Lines whose omairc- glob can also match an omairc-tui asset."""
    found = []
    for match in re.finditer(r"omairc-", text):
        rest = text[match.end():]
        if rest.startswith("tui-") or rest.startswith("[0-9]"):
            continue
        if not rest.startswith("*"):
            continue
        line_start = text.rfind("\n", 0, match.start()) + 1
        line_end = text.find("\n", match.end())
        if line_end < 0:
            line_end = len(text)
        found.append(text[line_start:line_end].strip())
    return found


def check_go_read_build_info():
    problems = []
    sentinel = "0.0.0-dev"
    for relative, source in sources("tui/**/*.go"):
        if Path(relative) == GO_VERSION_SOURCE:
            continue
        if "ReadBuildInfo" in source:
            problems.append(
                f"{relative}: debug.ReadBuildInfo is only allowed in "
                f"{GO_VERSION_SOURCE.as_posix()}")
        if sentinel in source:
            problems.append(
                f"{relative}: the {sentinel} sentinel lives only in "
                f"{GO_VERSION_SOURCE.as_posix()}")
    version_go = ROOT / GO_VERSION_SOURCE
    if not version_go.is_file():
        return [f"{GO_VERSION_SOURCE.as_posix()}: missing version fallback"] + problems
    text = version_go.read_text(encoding="utf-8", errors="replace")
    if sentinel not in text:
        problems.append(
            f"{GO_VERSION_SOURCE.as_posix()}: keep the {sentinel} sentinel "
            "for builds that do not inject a version")
    if "ReadBuildInfo" not in text:
        problems.append(
            f"{GO_VERSION_SOURCE.as_posix()}: when Value is still {sentinel}, "
            "fall back to debug.ReadBuildInfo")
    return problems


def check_tui_static_package():
    problems = []
    package = ROOT / "tui" / "bin" / "package"
    if not package.is_file():
        return ["tui/bin/package: missing static archive script"]
    text = package.read_text(encoding="utf-8", errors="replace")
    required = (
        ("bin/version", "read the version from bin/version"),
        ("OMAIRC_BUILD_VERSION", "honor OMAIRC_BUILD_VERSION"),
        ("CGO_ENABLED=0", "set CGO_ENABLED=0"),
        ("GOTOOLCHAIN=local", "pin GOTOOLCHAIN=local like packaging/tui/PKGBUILD"),
        ("-trimpath", "pass -trimpath"),
        ("internal/version.Value", "inject internal/version.Value"),
        ("-ldflags", "inject the version through -ldflags"),
        ("-s -w", "strip the release binary with -s -w"),
        ('./cmd/omairc-tui', "build only ./cmd/omairc-tui"),
        ("--mtime", "pin the archive mtime so release tarballs are reproducible"),
    )
    for needle, message in required:
        if needle not in text:
            problems.append(f"tui/bin/package: {message}")
    if "control-omairc-tui" in text:
        problems.append(
            "tui/bin/package: do not ship control-omairc-tui")
    return problems


def check_tui_install_script():
    problems = []
    path = ROOT / "install-tui.sh"
    if not path.is_file():
        return ["install-tui.sh: missing the portable terminal-client installer"]
    # Git records 100755, but a Windows checkout cannot show it; skip there.
    if sys.platform != "win32" and not path.stat().st_mode & 0o111:
        problems.append("install-tui.sh: must be executable")
    text = path.read_text(encoding="utf-8", errors="replace")
    required = (
        ("set -eu", "must fail fast"),
        ("https://github.com/fredimachado/omairc/releases",
         "must install from the GitHub release"),
        ("url_effective",
         "must resolve the latest release from the /latest redirect"),
        ("OMAIRC_TUI_VERSION", "must let a caller pin the version"),
        ("OMAIRC_TUI_BIN_DIR", "must let a caller choose the install directory"),
        ("$HOME/.local/bin", "must default to a user-local install directory"),
        ("Linux)", "must support Linux"),
        ("Darwin)", "must support macOS"),
        ("amd64", "must install the amd64 archive on x86_64"),
        ("arm64", "must install the arm64 archive on arm64 and aarch64"),
        ("tar.gz", "must install the .tar.gz release archive"),
        ("--version", "must verify the downloaded binary before installing it"),
        ("install -m 0755", "must install the binary executable"),
    )
    for needle, message in required:
        if needle not in text:
            problems.append(f"install-tui.sh: {message}")
    if re.search(r"(?m)(?:^|\s)sudo(?:\s|$)", text):
        problems.append(
            "install-tui.sh: must not require sudo; install under $HOME")
    if "raw.githubusercontent.com/fredimachado/omairc/main/install-tui.sh" \
            not in text:
        problems.append("install-tui.sh: usage must show the curl one-liner")
    for relative in ("README.md", "tui/README.md"):
        doc = ROOT / relative
        if not doc.is_file() or "install-tui.sh" not in doc.read_text(
                encoding="utf-8", errors="replace"):
            problems.append(f"{relative}: document install-tui.sh for omairc-tui")
    return problems


def check_tui_release_assets():
    problems = []
    # Anything that acts on release asset names, plus the user-facing install
    # instructions, must not use an omairc-* glob that also matches omairc-tui.
    files = (
        ".github/workflows/windows.yml",
        ".github/workflows/macos.yml",
        ".github/workflows/release-package.yml",
        ".github/workflows/tui.yml",
        "install.sh",
        "install-tui.sh",
        "README.md",
    )
    for relative in files:
        path = ROOT / relative
        if not path.is_file():
            problems.append(f"{relative}: missing file")
            continue
        for line in _omairc_star_globs(path.read_text(encoding="utf-8", errors="replace")):
            problems.append(
                f"{relative}: omairc-* glob can also match an "
                f"omairc-tui asset: {line}")

    release = ROOT / ".github" / "workflows" / "release-package.yml"
    if release.is_file():
        text = release.read_text(encoding="utf-8", errors="replace")
        if "tui/**" not in text or "packaging/tui/**" not in text:
            problems.append(
                ".github/workflows/release-package.yml: tag path filters "
                "must include tui/** and packaging/tui/**")
        if "omairc-tui-*-x86_64.pkg.tar.zst" not in text:
            problems.append(
                ".github/workflows/release-package.yml: repo-add the "
                "omairc-tui package into omairc.db")
        if "install-tui.sh" not in text:
            problems.append(
                ".github/workflows/release-package.yml: filter and upload "
                "install-tui.sh beside install.sh")
        if re.search(r"(?m)^  push:\n    branches:\n      - main\b", text):
            problems.append(
                ".github/workflows/release-package.yml: do not package on "
                "main pushes")

    formula = ROOT / "Formula" / "omairc-tui.rb"
    if not formula.is_file():
        problems.append("Formula/omairc-tui.rb: missing Homebrew formula")
    else:
        text = formula.read_text(encoding="utf-8", errors="replace")
        if "class OmaircTui < Formula" not in text:
            problems.append("Formula/omairc-tui.rb: declare class OmaircTui")
        if 'bin.install "omairc-tui"' not in text:
            problems.append('Formula/omairc-tui.rb: bin.install "omairc-tui"')
        if "strategy :github_latest" not in text:
            problems.append(
                "Formula/omairc-tui.rb: livecheck must use :github_latest")
        if "omairc-tui-#{version}-darwin-arm64.tar.gz" not in text \
                or "omairc-tui-#{version}-darwin-amd64.tar.gz" not in text:
            problems.append(
                "Formula/omairc-tui.rb: url must be the darwin arm64 and "
                "amd64 release tarballs")
        if re.search(r'^\s*app\s+"', text, re.MULTILINE):
            problems.append("Formula/omairc-tui.rb: do not install an app bundle")
        if 'depends_on "go"' in text:
            problems.append('Formula/omairc-tui.rb: do not depends_on "go"')

    manifest = ROOT / "bucket" / "omairc-tui.json"
    if not manifest.is_file():
        problems.append("bucket/omairc-tui.json: missing Scoop manifest")
    else:
        text = manifest.read_text(encoding="utf-8", errors="replace")
        if '"bin": "omairc-tui.exe"' not in text:
            problems.append('bucket/omairc-tui.json: bin must be omairc-tui.exe')
        if '"checkver"' not in text or '"autoupdate"' not in text:
            problems.append(
                "bucket/omairc-tui.json: keep checkver and autoupdate")
        install_section, _, autoupdate_section = text.partition('"autoupdate"')
        version_match = re.search(r'"version"\s*:\s*"([^"]+)"', text)
        install_url_match = re.search(
            r'"architecture"\s*:\s*\{\s*"64bit"\s*:\s*\{\s*"url"\s*:\s*"([^"]+)"',
            install_section)
        if version_match is None:
            problems.append("bucket/omairc-tui.json: missing version")
        elif install_url_match is None:
            problems.append(
                "bucket/omairc-tui.json: missing architecture 64bit url")
        else:
            install_url = install_url_match.group(1)
            if "$version" in install_url:
                problems.append(
                    "bucket/omairc-tui.json: install url must be literal; "
                    "$version belongs in autoupdate only")
            elif not install_url.endswith(
                    f"omairc-tui-{version_match.group(1)}-windows-amd64.zip"):
                problems.append(
                    "bucket/omairc-tui.json: install url must be the "
                    "windows-amd64 zip")
        if "omairc-tui-$version-windows-amd64.zip" not in autoupdate_section:
            problems.append(
                "bucket/omairc-tui.json: autoupdate url must keep "
                "omairc-tui-$version-windows-amd64.zip")

    homebrew = ROOT / "bin" / "bump-homebrew-tui"
    scoop = ROOT / "bin" / "bump-scoop-tui"
    if not homebrew.is_file():
        problems.append(
            "bin/bump-homebrew-tui: rewrite Formula/omairc-tui.rb from the "
            "darwin tarballs")
    else:
        text = homebrew.read_text(encoding="utf-8", errors="replace")
        if "Casks/omairc.rb" not in text or "refusing to open" not in text:
            problems.append(
                "bin/bump-homebrew-tui: must refuse to open Casks/omairc.rb")
        if "Formula" not in text or "darwin-" not in text \
                or '"arm64"' not in text or '"amd64"' not in text:
            problems.append(
                "bin/bump-homebrew-tui: must hash both darwin-arm64 and "
                "darwin-amd64 tarballs into Formula/omairc-tui.rb")
    if not scoop.is_file():
        problems.append(
            "bin/bump-scoop-tui: rewrite bucket/omairc-tui.json from the "
            "Windows zip")
    else:
        text = scoop.read_text(encoding="utf-8", errors="replace")
        if "bucket" not in text or "windows-amd64" not in text:
            problems.append(
                "bin/bump-scoop-tui: must rewrite the windows-amd64 hash in "
                "bucket/omairc-tui.json")
        if "autoupdate" not in text or "$version" not in text:
            problems.append(
                "bin/bump-scoop-tui: fill the literal install url from the "
                "autoupdate $version template")
        if "Casks" in text and "refusing to open" not in text:
            problems.append(
                "bin/bump-scoop-tui: must refuse to open Casks/omairc.rb")
    return problems


def check_homebrew_cask():
    problems = []
    path = ROOT / "Casks" / "omairc.rb"
    bump = ROOT / "bin" / "bump-homebrew-cask"
    workflow = ROOT / ".github" / "workflows" / "macos.yml"
    if (ROOT / "packaging" / "homebrew").exists():
        problems.append(
            "packaging/homebrew: cask lives in Casks/omairc.rb so "
            "`brew tap fredimachado/omairc` can see it")
    if not path.is_file():
        return ["Casks/omairc.rb: missing Homebrew cask"] + problems
    text = path.read_text(encoding="utf-8", errors="replace")
    if 'cask "omairc" do' not in text:
        problems.append('Casks/omairc.rb: declare cask "omairc"')
    if 'arch arm: "arm64", intel: "x64"' not in text:
        problems.append(
            "Casks/omairc.rb: dual GitHub zips need "
            'arch arm: "arm64", intel: "x64"')
    if "omairc-#{version}-macos-#{arch}.zip" not in text:
        problems.append(
            "Casks/omairc.rb: url must interpolate the GitHub "
            "omairc-#{version}-macos-#{arch}.zip asset")
    if "github.com/fredimachado/omairc/releases/download" not in text:
        problems.append(
            "Casks/omairc.rb: url must be the GitHub release zip")
    if not re.search(r'sha256 arm:\s+"[0-9a-f]{64}"', text):
        problems.append("Casks/omairc.rb: sha256 arm must be a real digest")
    if not re.search(r'intel:\s+"[0-9a-f]{64}"', text):
        problems.append("Casks/omairc.rb: sha256 intel must be a real digest")
    if "strategy :github_latest" not in text:
        problems.append(
            "Casks/omairc.rb: livecheck must track GitHub latest")
    if "depends_on :macos" not in text and "depends_on macos: :big_sur" not in text:
        problems.append(
            "Casks/omairc.rb: depends_on :macos (LSMinimumSystemVersion)")
    if 'app "omairc.app"' not in text:
        problems.append('Casks/omairc.rb: install omairc.app')
    if 'binary "#{appdir}/omairc.app/Contents/MacOS/omairc"' in text:
        problems.append(
            "Casks/omairc.rb: do not symlink Contents/MacOS/omairc; keep an "
            "exec wrapper so the Mach-O runs from the .app bundle")
    if 'binary "omairc"' not in text:
        problems.append(
            "Casks/omairc.rb: expose the CLI binary on PATH")
    if "preflight_steps" not in text \
            or 'exec "{{appdir}}/omairc.app/Contents/MacOS/omairc"' not in text:
        problems.append(
            "Casks/omairc.rb: PATH helper must exec the bundle Mach-O")
    if "caveats" not in text or "Start Omairc first" not in text:
        problems.append(
            "Casks/omairc.rb: caveats must say the CLI needs a running window")
    if "~/Library/Preferences/omairc" not in text:
        problems.append(
            "Casks/omairc.rb: zap must use macOS "
            "GenericConfigLocation (~/Library/Preferences/omairc)")
    if "~/Library/Preferences/State/omairc" not in text:
        problems.append(
            "Casks/omairc.rb: zap must use macOS "
            "GenericStateLocation (~/Library/Preferences/State/omairc)")
    if re.search(r"XDG_|~/\.config/omairc|Application Support/omairc", text):
        problems.append(
            "Casks/omairc.rb: zap must not use Linux $XDG_* or "
            "guessed Application Support paths")
    if re.search(r"uninstall[^\n]*delete", text) or "uninstall delete:" in text:
        problems.append(
            "Casks/omairc.rb: uninstall must leave config; put user files in zap")
    if "no-quarantine" in text or "xattr" in text:
        problems.append("Casks/omairc.rb: do not teach --no-quarantine")

    if not bump.is_file():
        problems.append(
            "bin/bump-homebrew-cask: rewrite Casks/omairc.rb from the tagged zips")
    else:
        bump_text = bump.read_text(encoding="utf-8", errors="replace")
        if "sha256" not in bump_text or "Casks" not in bump_text:
            problems.append(
                "bin/bump-homebrew-cask: must rewrite Casks/omairc.rb version "
                "and sha256")
        if "macos-arm64" not in bump_text or "macos-x64" not in bump_text:
            problems.append(
                "bin/bump-homebrew-cask: must hash both macos-arm64 and "
                "macos-x64 zips")
    workflow_text = workflow.read_text(encoding="utf-8", errors="replace") \
        if workflow.is_file() else ""
    if "bin/bump-homebrew-cask" not in workflow_text:
        problems.append(
            ".github/workflows/macos.yml: version tags must run "
            "bin/bump-homebrew-cask after both zips exist")
    if "needs: macos-zips" not in workflow_text:
        problems.append(
            ".github/workflows/macos.yml: Homebrew cask bump must wait for "
            "both architecture zips")
    if "git fetch origin main" not in workflow_text \
            or "git rebase origin/main" not in workflow_text:
        problems.append(
            ".github/workflows/macos.yml: cask bump must fetch and rebase "
            "onto origin/main when the push is not a fast-forward")
    if "max_attempts=5" not in workflow_text:
        problems.append(
            ".github/workflows/macos.yml: cask bump must retry a raced "
            "main push instead of leaving the cask on the prior version")
    if re.search(r"\*fetch first\*", workflow_text):
        problems.append(
            ".github/workflows/macos.yml: do not use *fetch first* as a "
            "case pattern; the space splits the arm and bash dies before "
            "git push")

    readme = ROOT / "README.md"
    section = macos_readme_section(
        readme.read_text(encoding="utf-8", errors="replace") if readme.is_file() else "")
    if not section:
        problems.append("README.md: missing ## macOS section")
        return problems
    if "raw.githubusercontent.com" in section:
        problems.append(
            "README.md: do not install the cask from a raw GitHub URL; tap Casks/")
    tap_pos = section.find(
        "brew tap fredimachado/omairc https://github.com/fredimachado/omairc")
    qualified_pos = section.find("brew install --cask fredimachado/omairc/omairc")
    official = re.search(r"(?m)^brew install --cask omairc$", section)
    zip_pos = section.find("omairc-<version>-macos-arm64.zip")
    source_pos = section.find("bin/build-macos-rust")
    if tap_pos < 0:
        problems.append(
            "README.md: macOS section must tap fredimachado/omairc with the "
            "repo URL")
    if qualified_pos < 0:
        problems.append(
            "README.md: macOS section must brew install --cask "
            "fredimachado/omairc/omairc")
    if official is None:
        problems.append(
            "README.md: macOS section must keep brew install --cask omairc "
            "for when Homebrew has the cask")
    if zip_pos < 0:
        problems.append("README.md: macOS section must mention the GitHub zip")
    if source_pos < 0:
        problems.append("README.md: macOS section must keep the from-source build")
    if tap_pos >= 0 and zip_pos >= 0 and tap_pos > zip_pos:
        problems.append(
            "README.md: macOS section must lead with the tap, then the zip")
    if zip_pos >= 0 and source_pos >= 0 and zip_pos > source_pos:
        problems.append(
            "README.md: macOS section must put the zip before the from-source build")
    return problems


CHECKS = (
    ("single version source", check_version_source),
    ("Cargo version matches version.pri", check_cargo_version_matches_version_pri),
    ("Rust product crate at client/", check_client_crate),
    ("client/TUI shared IRC contract", check_shared_irc_contract),
    ("Go version source", check_go_version_source),
    ("Go build reads version.pri", check_go_build_uses_version_pri),
    ("Go ReadBuildInfo version fallback", check_go_read_build_info),
    ("TUI static package script", check_tui_static_package),
    ("TUI install script", check_tui_install_script),
    ("TUI release assets", check_tui_release_assets),
    ("internal/irc platform neutrality", check_go_irc_platform_neutrality),
    ("Go view/driver free of internal/irc", check_go_view_no_protocol),
    ("Go title strings only in title.go", check_go_title_strings),
    ("macOS CI host arch selection", check_macos_ci_arch_selection),
    ("CI packages only on tags and dispatch", check_ci_package_triggers),
    ("macOS CI Bash 3.2 builtins", check_macos_ci_bash32),
    ("macOS Developer ID notarization", check_macos_notarization),
    ("macOS CI Xcode and Actions majors", check_macos_ci_xcode_and_actions),
    ("Homebrew macOS cask", check_homebrew_cask),
)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) == 2 and argv[0] == "--to-cargo-semver":
        sys.stdout.write(version_pri_to_cargo_semver(argv[1]))
        return 0
    if len(argv) == 1 and argv[0] == "--omairc-lock-version":
        text = _read_text(ROOT / "client" / "Cargo.lock")
        if text is None:
            print("client/Cargo.lock: missing", file=sys.stderr)
            return 1
        lock_ver = _cargo_lock_omairc_version(text)
        if lock_ver is None:
            print(
                'client/Cargo.lock: missing [[package]] name = "omairc" version',
                file=sys.stderr)
            return 1
        sys.stdout.write(lock_ver)
        return 0
    if argv:
        print(
            "Usage: bin/check-conventions "
            "[--to-cargo-semver VERSION | --omairc-lock-version]",
            file=sys.stderr)
        return 2

    failed = False
    for title, check in CHECKS:
        problems = check()
        if problems:
            failed = True
            print(f"{title}:", file=sys.stderr)
            for problem in problems:
                print(f"  {problem}", file=sys.stderr)
    if failed:
        return 1
    print(f"conventions: {len(CHECKS)} checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
