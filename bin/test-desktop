#!/usr/bin/env sh
# Black-box desktop smoke against the Rust client via control-omairc-desktop.
# Needs Xvfb, xauth, xdotool, xinput, ImageMagick, cargo, and lavapipe
# (vulkan-swrast). Not in CI; verify-desktop covers the feature-map recipes.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
CONTROL="$ROOT/.cursor/skills/verify-omairc-desktop/control-omairc-desktop"
# Screenshots land at test-artifacts/desktop/<name>.png (feature id = desktop).
ARTIFACTS="$ROOT/test-artifacts"
DESKTOP_SHOTS="$ARTIFACTS/desktop"

cleanup() {
  "$CONTROL" cleanup >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

test -x "$CONTROL" || {
  echo "missing $CONTROL" >&2
  exit 1
}

# Product release binary, same profile PKGBUILD / bin/test-install ship.
export OMAIRC_DESKTOP_PROFILE=release
export OMAIRC_DESKTOP_FEATURES=product
export OMAIRC_VERIFY_DESKTOP_EVIDENCE="$ARTIFACTS"

mkdir -p "$DESKTOP_SHOTS"
cleanup

"$CONTROL" launch --demo-server
"$CONTROL" wait-title --exact "#omarchy · irc.example · fred - Omairc"

# Switch to #desktop (keyboard path; pixel coords differ from the Qt layout).
"$CONTROL" jump --query "#desktop"
"$CONTROL" wait-title --exact "#desktop - Omairc"
"$CONTROL" screenshot --feature desktop --name switch-channel

# Compose and submit a message.
"$CONTROL" send --text "Hello from the desktop test"
"$CONTROL" screenshot --feature desktop --name send-message
"$CONTROL" compare \
  --before "$DESKTOP_SHOTS/switch-channel.png" \
  --after "$DESKTOP_SHOTS/send-message.png"

# Adjacent rows on #desktop (alphabetical, no PREFIX): kai then mira.
"$CONTROL" click-member --name kai
"$CONTROL" wait-title --exact "kai - Omairc"
"$CONTROL" jump --query "#desktop"
"$CONTROL" wait-title --exact "#desktop - Omairc"
"$CONTROL" click-member --name mira
"$CONTROL" wait-title --exact "mira - Omairc"
"$CONTROL" screenshot --feature desktop --name open-direct-message

# Return to a channel and toggle the member panel.
"$CONTROL" jump --query "#desktop"
"$CONTROL" wait-title --exact "#desktop - Omairc"
"$CONTROL" screenshot --feature desktop --name members-before-toggle
"$CONTROL" toggle-members
"$CONTROL" screenshot --feature desktop --name toggle-members
"$CONTROL" compare \
  --before "$DESKTOP_SHOTS/members-before-toggle.png" \
  --after "$DESKTOP_SHOTS/toggle-members.png"

"$CONTROL" doctor >/dev/null

echo "Desktop UI tests passed. Screenshots: test-artifacts/desktop/"
