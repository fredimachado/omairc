#!/usr/bin/env sh
# Sanitizer gate for the Rust client. The Qt ASan/UBSan suite is gone; this
# runs the locked cargo test suite (default product features). Full AddressSanitizer
# for Rust needs nightly -Zsanitizer and is not required here.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

command -v cargo >/dev/null 2>&1 || {
  echo "cargo is required for bin/test-san." >&2
  exit 1
}

cd "$ROOT/client"
cargo test --locked
echo "bin/test-san: ok"
