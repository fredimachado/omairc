#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
  QMAKE=qmake
else
  echo "A Qt 6 qmake (qmake6) is required to build omairc." >&2
  exit 1
fi

JOBS="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/omairc.pro"
make -j"$JOBS"

if [ -x "$BUILD_DIR/omairc" ]; then
  echo "Built $BUILD_DIR/omairc"
elif [ -x "$BUILD_DIR/omairc.app/Contents/MacOS/omairc" ]; then
  echo "Built $BUILD_DIR/omairc.app/Contents/MacOS/omairc"
else
  echo "Build finished but omairc binary was not found under $BUILD_DIR." >&2
  exit 1
fi
