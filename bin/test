#!/usr/bin/env sh
# Default gate for the Rust desktop client and the TUI.
# Conventions, cargo test + clippy, version/help smoke, and tui/bin/test.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/check-conventions"
# tui/bin/test runs the same gate, so mark it done to keep the root gate from
# running it twice.
OMAIRC_CONVENTIONS_RAN=1
export OMAIRC_CONVENTIONS_RAN
if command -v go >/dev/null 2>&1; then
  "$ROOT/tui/bin/test"
else
  echo "Skipping tui/bin/test: go is not on PATH." >&2
fi

command -v cargo >/dev/null 2>&1 || {
  echo "cargo is required to test omairc." >&2
  exit 1
}

# Default features include product. Clippy matches CI: deny warnings, allow the
# noisy style/complexity groups until a cleanup slice.
(
  cd "$ROOT/client"
  cargo test --locked
  cargo clippy --locked --all-targets -- \
    -D warnings \
    -A clippy::style \
    -A clippy::complexity \
    -A clippy::pedantic \
    -A clippy::nursery \
    -A clippy::perf
  # Side-by-side omairc-poc identity still compiles and its cfg(dev) tests run.
  cargo test --locked --features dev
)

python3 -m unittest -v tests.test_derive_build_versions

VERSION="$("$ROOT/bin/version")"
export OMAIRC_BUILD_VERSION="$VERSION"
(
  cd "$ROOT/client"
  cargo build --locked
)
OMAIRC_BIN="$ROOT/client/target/debug/omairc"
test -x "$OMAIRC_BIN" || {
  echo "missing $OMAIRC_BIN after cargo build" >&2
  exit 1
}

got="$(DISPLAY= "$OMAIRC_BIN" --version)"
test "$got" = "omairc $VERSION" || {
  echo "--version must print exactly omairc $VERSION" >&2
  printf 'got: %s\n' "$got" >&2
  exit 1
}

OVERRIDE_VERSION="${VERSION}+main.gdeadbeef"
export OMAIRC_BUILD_VERSION="$OVERRIDE_VERSION"
(
  cd "$ROOT/client"
  cargo build --locked
)
override_got="$(DISPLAY= "$OMAIRC_BIN" --version)"
test "$override_got" = "omairc $OVERRIDE_VERSION" || {
  echo "OMAIRC_BUILD_VERSION must appear in omairc --version" >&2
  printf 'got: %s\n' "$override_got" >&2
  exit 1
}
# Restore the clean bake for any follow-on local use of this tree.
export OMAIRC_BUILD_VERSION="$VERSION"
(
  cd "$ROOT/client"
  cargo build --locked
) >/dev/null

assert_not_version_line() {
  first_line=$(printf '%s\n' "$1" | head -n 1)
  case "$first_line" in
    omairc\ [0-9]*)
      echo "$2 printed the version line." >&2
      exit 1
      ;;
  esac
}

is_json_object() {
  case "$1" in
    \{*) return 0 ;;
    *) return 1 ;;
  esac
}

set +e
HELP_OUTPUT="$(DISPLAY= "$OMAIRC_BIN" --help 2>&1)"
HELP_STATUS=$?
set -e
if [ "$HELP_STATUS" -ne 0 ]; then
  echo "omairc --help failed." >&2
  exit 1
fi
assert_not_version_line "$HELP_OUTPUT" "omairc --help"
if is_json_object "$HELP_OUTPUT"; then
  echo "omairc --help must not print JSON." >&2
  exit 1
fi
for token in connections list status send read names conversations raise --demo-server --version; do
  printf '%s\n' "$HELP_OUTPUT" | grep -Fq -- "$token" || {
    echo "omairc --help must mention $token" >&2
    exit 1
  }
done

for command in connections list status send read names conversations raise; do
  set +e
  COMMAND_HELP="$(DISPLAY= "$OMAIRC_BIN" "$command" --help 2>&1)"
  COMMAND_STATUS=$?
  set -e
  if [ "$COMMAND_STATUS" -ne 0 ]; then
    echo "omairc $command --help failed." >&2
    exit 1
  fi
  if is_json_object "$COMMAND_HELP"; then
    echo "omairc $command --help must not print JSON." >&2
    exit 1
  fi
done

set +e
SEND_HELP="$(DISPLAY= "$OMAIRC_BIN" send --help 2>&1)"
SEND_HELP_STATUS=$?
set -e
if [ "$SEND_HELP_STATUS" -ne 0 ]; then
  echo "omairc send --help failed." >&2
  exit 1
fi
assert_not_version_line "$SEND_HELP" "omairc send --help"
if is_json_object "$SEND_HELP"; then
  echo "omairc send --help must not print JSON." >&2
  exit 1
fi
printf '%s\n' "$SEND_HELP" | grep -Fq -- "Usage: omairc send" || {
  echo "omairc send --help must print send usage." >&2
  exit 1
}

set +e
SEND_TEXT="$(DISPLAY= "$OMAIRC_BIN" send '#c' --help 2>&1)"
set -e
printf '%s\n' "$SEND_TEXT" | grep -Fq -- "Usage: omairc send" && {
  echo "omairc send '#c' --help must not print the send help page." >&2
  exit 1
}

if [ "$(uname -s)" != Darwin ]; then
  COMPLETION="$ROOT/data/bash-completion/omairc"
  COMPREPLY_TEXT="$(bash -c '
    source "$1"
    COMP_WORDS=(omairc "")
    COMP_CWORD=1
    _omairc
    printf "%s\n" "${COMPREPLY[@]}"
  ' bash "$COMPLETION")"
  printf '%s\n' "$COMPREPLY_TEXT" | grep -Fxq send || {
    echo "bash completion at the first token must include send." >&2
    exit 1
  }
  printf '%s\n' "$COMPREPLY_TEXT" | grep -Fxq -- --help || {
    echo "bash completion at the first token must include --help." >&2
    exit 1
  }
  HELP_COMPREPLY_TEXT="$(bash -c '
    source "$1"
    COMP_WORDS=(omairc help "s")
    COMP_CWORD=2
    _omairc
    printf "%s\n" "${COMPREPLY[@]}"
  ' bash "$COMPLETION")"
  printf '%s\n' "$HELP_COMPREPLY_TEXT" | grep -Fxq send || {
    echo "bash completion for help must include send." >&2
    exit 1
  }
  printf '%s\n' "$HELP_COMPREPLY_TEXT" | grep -Fxq status || {
    echo "bash completion for help must include status." >&2
    exit 1
  }
  for token in connections list status send read names conversations raise; do
    printf '%s\n' "$HELP_OUTPUT" | grep -Fq -- "$token" || continue
    grep -Fq -- "$token" "$COMPLETION" || {
      echo "completion file must mention control verb $token from --help." >&2
      exit 1
    }
  done
fi

set +e
CLI_OUTPUT="$("$OMAIRC_BIN" send '#channel' please use --version 2>&1)"
CLI_STATUS=$?
set -e
case "$CLI_OUTPUT" in
  "omairc "*)
    echo "CLI treated message text as --version." >&2
    exit 1
    ;;
esac
if [ "$CLI_STATUS" -eq 0 ]; then
  echo "CLI send invocation unexpectedly succeeded without a server." >&2
  exit 1
fi

echo "bin/test: ok"
