#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/check-conventions"
TEST_STATE="$(mktemp -d "${TMPDIR:-/tmp}/omairc-tests.XXXXXX")"

cleanup() {
  rm -rf -- "$TEST_STATE"
}
trap cleanup EXIT HUP INT TERM

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
  QMAKE=qmake
else
  echo "A Qt 6 qmake (qmake6) is required to test omairc." >&2
  exit 1
fi

JOBS="$(nproc 2>/dev/null || echo 1)"

"$ROOT/bin/build"

VERSION="$("$ROOT/bin/version")"
got="$(DISPLAY= "$ROOT/build/omairc" --version)"
test "$got" = "omairc $VERSION" || {
  echo "--version must print exactly omairc $VERSION" >&2
  printf 'got: %s\n' "$got" >&2
  exit 1
}

assert_not_version_line() {
  first_line=$(printf '%s\n' "$1" | head -n 1)
  case "$first_line" in
    omairc\ [0-9]*)
      echo "$2 printed the version line." >&2
      exit 1
      ;;
  esac
}

is_json_object() {
  case "$1" in
    \{*) return 0 ;;
    *) return 1 ;;
  esac
}

set +e
HELP_OUTPUT="$(DISPLAY= "$ROOT/build/omairc" --help 2>&1)"
HELP_STATUS=$?
set -e
if [ "$HELP_STATUS" -ne 0 ]; then
  echo "omairc --help failed." >&2
  exit 1
fi
assert_not_version_line "$HELP_OUTPUT" "omairc --help"
if is_json_object "$HELP_OUTPUT"; then
  echo "omairc --help must not print JSON." >&2
  exit 1
fi
for token in connections list status send raise --mock --version; do
  printf '%s\n' "$HELP_OUTPUT" | grep -Fq -- "$token" || {
    echo "omairc --help must mention $token" >&2
    exit 1
  }
done

for command in connections list status send raise; do
  set +e
  COMMAND_HELP="$(DISPLAY= "$ROOT/build/omairc" "$command" --help 2>&1)"
  COMMAND_STATUS=$?
  set -e
  if [ "$COMMAND_STATUS" -ne 0 ]; then
    echo "omairc $command --help failed." >&2
    exit 1
  fi
  if is_json_object "$COMMAND_HELP"; then
    echo "omairc $command --help must not print JSON." >&2
    exit 1
  fi
done

set +e
SEND_HELP="$(DISPLAY= "$ROOT/build/omairc" send --help 2>&1)"
SEND_HELP_STATUS=$?
set -e
if [ "$SEND_HELP_STATUS" -ne 0 ]; then
  echo "omairc send --help failed." >&2
  exit 1
fi
assert_not_version_line "$SEND_HELP" "omairc send --help"
if is_json_object "$SEND_HELP"; then
  echo "omairc send --help must not print JSON." >&2
  exit 1
fi
printf '%s\n' "$SEND_HELP" | grep -Fq -- "Usage: omairc send" || {
  echo "omairc send --help must print send usage." >&2
  exit 1
}

set +e
SEND_TEXT="$(DISPLAY= "$ROOT/build/omairc" send '#c' --help 2>&1)"
set -e
printf '%s\n' "$SEND_TEXT" | grep -Fq -- "Usage: omairc send" && {
  echo "omairc send '#c' --help must not print the send help page." >&2
  exit 1
}

COMPLETION="$ROOT/data/bash-completion/omairc"
COMPREPLY_TEXT="$(bash -c '
  source "$1"
  COMP_WORDS=(omairc "")
  COMP_CWORD=1
  _omairc
  printf "%s\n" "${COMPREPLY[@]}"
' bash "$COMPLETION")"
printf '%s\n' "$COMPREPLY_TEXT" | grep -Fxq send || {
  echo "bash completion at the first token must include send." >&2
  exit 1
}
printf '%s\n' "$COMPREPLY_TEXT" | grep -Fxq -- --help || {
  echo "bash completion at the first token must include --help." >&2
  exit 1
}
HELP_COMPREPLY_TEXT="$(bash -c '
  source "$1"
  COMP_WORDS=(omairc help "s")
  COMP_CWORD=2
  _omairc
  printf "%s\n" "${COMPREPLY[@]}"
' bash "$COMPLETION")"
printf '%s\n' "$HELP_COMPREPLY_TEXT" | grep -Fxq send || {
  echo "bash completion for help must include send." >&2
  exit 1
}
printf '%s\n' "$HELP_COMPREPLY_TEXT" | grep -Fxq status || {
  echo "bash completion for help must include status." >&2
  exit 1
}
for token in connections list status send raise; do
  printf '%s\n' "$HELP_OUTPUT" | grep -Fq -- "$token" || continue
  grep -Fq -- "$token" "$COMPLETION" || {
    echo "completion file must mention control verb $token from --help." >&2
    exit 1
  }
done

set +e
CLI_OUTPUT="$("$ROOT/build/omairc" send '#channel' please use --version 2>&1)"
CLI_STATUS=$?
set -e
case "$CLI_OUTPUT" in
  "omairc "*)
    echo "CLI treated message text as --version." >&2
    exit 1
    ;;
esac
if [ "$CLI_STATUS" -eq 0 ]; then
  echo "CLI send invocation unexpectedly succeeded without a server." >&2
  exit 1
fi

mkdir -p "$ROOT/build-tests"
cd "$ROOT/build-tests"
"$QMAKE" "$ROOT/tests/tests.pro"
make -j"$JOBS"
./protocol_tests

mkdir -p "$ROOT/build-seeded-qml-tests"
cd "$ROOT/build-seeded-qml-tests"
"$QMAKE" "$ROOT/tests/ui/seeded-qml.pro"
make -j"$JOBS"

mkdir -p "$ROOT/test-artifacts"
SCREENSHOTS="switch-channel send-message toggle-members open-direct-message"
for screenshot in $SCREENSHOTS; do
  rm -f -- "$ROOT/test-artifacts/$screenshot.png"
done

cd "$ROOT"
XDG_CONFIG_HOME="$TEST_STATE/config" \
XDG_CACHE_HOME="$TEST_STATE/cache" \
XDG_DATA_HOME="$TEST_STATE/data" \
XDG_STATE_HOME="$TEST_STATE/state" \
QT_QPA_PLATFORM=offscreen \
QT_QPA_PLATFORMTHEME= \
QT_QUICK_BACKEND=software \
"$ROOT/build-seeded-qml-tests/seeded_qml_tests" -input "$ROOT/tests/ui/tst_omairc.qml"

cd "$ROOT"
XDG_CONFIG_HOME="$TEST_STATE/config" \
XDG_CACHE_HOME="$TEST_STATE/cache" \
XDG_DATA_HOME="$TEST_STATE/data" \
XDG_STATE_HOME="$TEST_STATE/state" \
QT_QPA_PLATFORM=offscreen \
QT_QPA_PLATFORMTHEME= \
QT_QUICK_BACKEND=software \
"$ROOT/build-seeded-qml-tests/seeded_qml_tests" -input "$ROOT/tests/ui/tst_seeded_window.qml"

mkdir -p "$ROOT/build-live-ui-tests"
cd "$ROOT/build-live-ui-tests"
"$QMAKE" "$ROOT/tests/live-ui/live-ui.pro"
make -j"$JOBS"

mkdir -p "$ROOT/test-artifacts/live-ui"
rm -f -- "$ROOT/test-artifacts/live-ui/live-ui-grouped-messages.png"
rm -f -- "$ROOT/test-artifacts/live-ui/live-ui-replay-history.png"
rm -f -- "$ROOT/test-artifacts/live-ui/live-ui-bouncer-direct.png"
rm -f -- "$ROOT/test-artifacts/live-ui/live-ui-find.png"
rm -f -- "$ROOT/test-artifacts/live-ui/live-ui-seeded-mock-world.png"
for screenshot in $SCREENSHOTS; do
  rm -f -- "$ROOT/test-artifacts/$screenshot.png"
done

cd "$ROOT"
XDG_CONFIG_HOME="$TEST_STATE/config" \
XDG_CACHE_HOME="$TEST_STATE/cache" \
XDG_DATA_HOME="$TEST_STATE/data" \
QT_QPA_PLATFORM=offscreen \
QT_QPA_PLATFORMTHEME= \
QT_QUICK_BACKEND=software \
OMAIRC_LIVE_UI_ARTIFACTS="$ROOT/test-artifacts/live-ui" \
OMAIRC_UI_ARTIFACTS="$ROOT/test-artifacts" \
"$ROOT/build-live-ui-tests/live_ui_tests" consecutiveSameAuthorMinuteGroupsThroughIrcEvent memberJoinPartModeUpdatesWithoutReset replayAndLiveSameAuthorMinuteDoNotGroupThroughIrcEvent bouncerQueryReplayRendersDirectMessageInSidebar ctrlFFindsLiveTranscriptAndStatus seededIrcFixtureFurnishesMockWorld

if [ ! -s "$ROOT/test-artifacts/live-ui/live-ui-grouped-messages.png" ]; then
  echo "live_ui_tests did not create test-artifacts/live-ui/live-ui-grouped-messages.png." >&2
  exit 1
fi
if [ ! -s "$ROOT/test-artifacts/live-ui/live-ui-replay-history.png" ]; then
  echo "live_ui_tests did not create test-artifacts/live-ui/live-ui-replay-history.png." >&2
  exit 1
fi
if [ ! -s "$ROOT/test-artifacts/live-ui/live-ui-bouncer-direct.png" ]; then
  echo "live_ui_tests did not create test-artifacts/live-ui/live-ui-bouncer-direct.png." >&2
  exit 1
fi
if [ ! -s "$ROOT/test-artifacts/live-ui/live-ui-find.png" ]; then
  echo "live_ui_tests did not create test-artifacts/live-ui/live-ui-find.png." >&2
  exit 1
fi
if [ ! -s "$ROOT/test-artifacts/live-ui/live-ui-seeded-mock-world.png" ]; then
  echo "live_ui_tests did not create test-artifacts/live-ui/live-ui-seeded-mock-world.png." >&2
  exit 1
fi
for screenshot in $SCREENSHOTS; do
  if [ ! -s "$ROOT/test-artifacts/$screenshot.png" ]; then
    echo "live_ui_tests did not create test-artifacts/$screenshot.png." >&2
    exit 1
  fi
done
