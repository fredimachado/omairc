cmd_walk() {
  direction=
  times=1
  while [ $# -gt 0 ]; do
    case $1 in
      --down|--up)
        [ -z "$direction" ] || die "walk accepts only one of --down or --up"
        direction=${1#--}
        shift
        ;;
      --times)
        [ $# -ge 2 ] || die "walk requires --times N"
        times=$2
        shift 2
        ;;
      *) die "unknown walk argument: $1" ;;
    esac
  done
  [ -n "$direction" ] || die "walk requires --down or --up"
  case $times in
    *[!0-9]*|"") die "walk --times requires a positive integer" ;;
  esac
  times=$(printf '%s' "$times" | sed 's/^0*//')
  [ -n "$times" ] || die "walk --times requires a positive integer"
  if [ "$direction" = down ]; then
    key=alt+Down
  else
    key=alt+Up
  fi
  step=0
  while [ "$step" -lt "$times" ]; do
    cmd_key --key "$key"
    step=$((step + 1))
  done
}

