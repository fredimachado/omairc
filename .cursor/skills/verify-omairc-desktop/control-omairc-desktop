    alt+shift+a) key=Alt_L+Shift_L+a ;;
    alt+shift+Left) key=Alt_L+Shift_L+Left ;;
    alt+shift+Right) key=Alt_L+Shift_L+Right ;;
    alt+shift+Up) key=Alt_L+Shift_L+Up ;;
    alt+shift+Down) key=Alt_L+Shift_L+Down ;;
    ctrl+alt+shift+Left) key=Control_L+Alt_L+Shift_L+Left ;;
    ctrl+alt+shift+Right) key=Control_L+Alt_L+Shift_L+Right ;;
