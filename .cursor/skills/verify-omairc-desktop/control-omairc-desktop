self_check_timeout_validator() {
  _got=$(validate_wait_title_timeout 08) || return 1
  [ "$_got" = 8 ] || die "self-check: parse 08 expected 8 got $_got"
  _got=$(validate_wait_title_timeout 010)
  [ "$_got" = 10 ] || die "self-check: parse 010 expected 10 got $_got"
  _got=$(validate_wait_title_timeout 10s)
  [ "$_got" = 10 ] || die "self-check: parse 10s expected 10 got $_got"
  if ( validate_wait_title_timeout 00 ) >/dev/null 2>&1; then
    die "self-check: parse 00 should fail"
  fi
  if ( validate_wait_title_timeout abc ) >/dev/null 2>&1; then
    die "self-check: parse abc should fail"
  fi
  if ( validate_wait_title_timeout -5 ) >/dev/null 2>&1; then
    die "self-check: parse -5 should fail"
  fi
  if ( validate_wait_title_timeout 10junk ) >/dev/null 2>&1; then
    die "self-check: parse 10junk should fail"
  fi
  if ( validate_wait_title_timeout 99999 ) >/dev/null 2>&1; then
    die "self-check: parse 99999 should fail"
  fi
  if ( validate_wait_title_timeout 99999999999999999999 ) >/dev/null 2>&1; then
    die "self-check: parse huge timeout should fail"
  fi
  if ( "$SELF" wait-title --exact foo --timeout 99999999999999999999 ) >/dev/null 2>&1; then
    die "self-check: --timeout huge value should fail"
  fi
  if ! ( OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT=abc "$SELF" cleanup ) >/dev/null 2>&1; then
    die "self-check: cleanup should work with bad OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT"
  fi
  _env_launch_err=$(
    OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT=abc "$SELF" launch --demo-server 2>&1 >/dev/null || true
  )
  case $_env_launch_err in
    *"invalid OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT 'abc'"*) ;;
    *) die "self-check: env launch error expected variable name, got '$_env_launch_err'" ;;
  esac
  "$SELF" cleanup >/dev/null 2>&1 || true
  if ( OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT=0 "$SELF" launch --demo-server ) >/dev/null 2>&1; then
    die "self-check: env OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT=0 should fail on launch"
  fi
  "$SELF" cleanup >/dev/null 2>&1 || true
  if ( validate_wait_title_timeout 1m ) >/dev/null 2>&1; then
    die "self-check: parse 1m should fail"
  fi
}

self_check_failed_launch_xvfb() {
  _known_pids=$(pgrep Xvfb 2>/dev/null | sort -u | tr '\n' ' ')
  _fake=$(mktemp "${TMPDIR:-/tmp}/omairc-verify-fake-bin.XXXXXX")
  printf '#!/bin/sh\nexit 1\n' >"$_fake"
  chmod +x "$_fake"
  _try=0
  while [ "$_try" -lt 3 ]; do
    _try=$((_try + 1))
    set +e
    OMAIRC_VERIFY_DESKTOP_BINARY="$_fake" "$SELF" launch --demo-server >/dev/null 2>&1
    set -e
  done
  rm -f "$_fake"
  _after_pids=$(pgrep Xvfb 2>/dev/null | sort -u || true)
  for _pid in $_after_pids; do
    case " $_known_pids " in
      *" $_pid "*) ;;
      *) die "self-check: failed launch left orphan Xvfb pid $_pid" ;;
    esac
  done
}

self_check_click_member_desktop() {
  "$SELF" jump --query "#desktop" >/dev/null
  "$SELF" wait-title --exact "#desktop - Omairc" >/dev/null
  "$SELF" click-member --name kai >/dev/null
  "$SELF" wait-title --exact "kai - Omairc" >/dev/null
  "$SELF" jump --query "#desktop" >/dev/null
  "$SELF" wait-title --exact "#desktop - Omairc" >/dev/null
  "$SELF" click-member --name mira >/dev/null
  "$SELF" wait-title --exact "mira - Omairc" >/dev/null
}

cmd_self_check() {
  require_tools
  _saved_verify_state=${OMAIRC_VERIFY_DESKTOP_STATE-}
  _self_check_temp_state=$(mktemp "${TMPDIR:-/tmp}/omairc-verify-self-check-state.XXXXXX")
  export OMAIRC_VERIFY_DESKTOP_STATE="$_self_check_temp_state"
  STATE_FILE="$_self_check_temp_state"

  _self_check_teardown() {
    STATE_FILE="$_self_check_temp_state"
    cmd_cleanup >/dev/null 2>&1 || true
    rm -f "$_self_check_temp_state"
    if [ -n "$_saved_verify_state" ]; then
      export OMAIRC_VERIFY_DESKTOP_STATE="$_saved_verify_state"
    else
      unset OMAIRC_VERIFY_DESKTOP_STATE
    fi
    STATE_FILE="${OMAIRC_VERIFY_DESKTOP_STATE:-${TMPDIR:-/tmp}/omairc-verify-desktop-$USER/state}"
  }
  trap _self_check_teardown EXIT INT HUP TERM

  self_check_timeout_validator
  self_check_failed_launch_xvfb
  if ! "$SELF" launch --demo-server >/dev/null; then
    die "self-check: launch failed"
  fi
  load_state
  if ! "$SELF" title >/dev/null; then
    die "self-check: title should succeed on live app"
  fi
  load_state
  SELF_CHECK_FORCE_EMPTY_TITLE=1
  set +e
  _title_err=$(cmd_title 2>&1 >/dev/null)
  _empty_title_st=$?
  set -e
  unset SELF_CHECK_FORCE_EMPTY_TITLE
  [ "$_empty_title_st" -ne 0 ] || die "self-check: title should fail on unreadable window"
  case $_title_err in
    *"cannot read window title"*|*"Omairc window not found"*) ;;
    *) die "self-check: title error expected cannot read/window not found, got '$_title_err'" ;;
  esac
  _start_ms=$(now_ms)
  set +e
  "$SELF" wait-title --exact "never-matches" --timeout 1 >/dev/null 2>&1
  _wait_st=$?
  set -e
  _elapsed=$(( $(now_ms) - _start_ms ))
  [ "$_wait_st" -ne 0 ] || die "self-check: wait-title --timeout 1 should fail"
  [ "$_elapsed" -ge 1000 ] || die "self-check: wait-title --timeout 1 ended early (${_elapsed}ms)"
  if ( "$SELF" wait-title --exact foo --timeout ) >/dev/null 2>&1; then
    die "self-check: wait-title --timeout without value should fail"
  fi
  self_check_click_member_desktop
  load_state
  kill -9 "$APP_PID" 2>/dev/null || true
  wait "$APP_PID" 2>/dev/null || true
  set +e
  _dead_title_err=$("$SELF" title 2>&1 >/dev/null)
  _title_st=$?
  ( poll_window_title_exact "never-matches" 2 ) >/dev/null 2>&1
  _status=$?
  set -e
  if [ "$_title_st" -eq 0 ]; then
    die "self-check: title should fail when app is dead"
  fi
  case $_dead_title_err in
    *"Omairc pid"*|*"cannot read window title"*|*"Omairc window not found"*) ;;
    *) die "self-check: dead-app title error expected pid/window message, got '$_dead_title_err'" ;;
  esac
  _dead_msg_count=$(printf '%s\n' "$_dead_title_err" | grep -c 'Omairc pid.*is not running' || true)
  [ "$_dead_msg_count" -eq 1 ] || die "self-check: dead-app title message should appear once (got $_dead_msg_count)"
  if [ "$_status" -eq 0 ]; then
    die "self-check: wait-title should fail when app is dead"
  fi
  echo "self-check ok"
}

cmd_cleanup() {
  if [ -f "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    stop_pid "${APP_PID:-}"
    stop_pid "${XVFB_PID:-}"
    if [ -n "${STATE_DIR:-}" ] && [ -d "$STATE_DIR" ]; then
      rm -rf -- "$STATE_DIR"
    fi
    rm -f -- "$STATE_FILE"
  fi
  echo "cleaned isolated instance"
  echo "evidence kept at $EVIDENCE_DIR"
}

# Print one eval-safe word. Single quotes keep "#desktop" from becoming a comment.
shell_quote_word() {
  _word=$1
  _escaped=$(printf '%s' "$_word" | sed "s/'/'\\\\''/g")
  printf "'%s'" "$_escaped"
}

# Print the recipe line as eval-safe words for `eval "set -- ..."`.
# Unbalanced quotes exit 1 after a message. A trailing unquoted # is a comment.
shell_quote_line() {
  _rest=$1
  _built=
  while :; do
    while :; do
      case $_rest in
        "") break 2 ;;
        " "*) _rest=${_rest# } ;;
        "	"*) _rest=${_rest#	} ;;
        *) break ;;
      esac
    done
    case $_rest in
      \#*) break ;;
    esac
    _token=
    _mode=none
    _skip_token=0
    while [ -n "$_rest" ]; do
      _char=${_rest%"${_rest#?}"}
      _rest=${_rest#?}
      case $_mode in
        none)
          case $_char in
            " "|"	") break ;;
            "'") _mode=single ;;
            '"') _mode=double ;;
            \#)
              if [ -z "$_token" ]; then
                _skip_token=1
                _rest=
              else
                _token=$_token$_char
              fi
              ;;
            *) _token=$_token$_char ;;
          esac
          ;;
        single)
          case $_char in
            "'") _mode=none ;;
            *) _token=$_token$_char ;;
          esac
          ;;
        double)
          case $_char in
            '"') _mode=none ;;
            *) _token=$_token$_char ;;
          esac
          ;;
      esac
    done
    if [ "$_mode" != none ]; then
      die "unbalanced quotes in desktop recipe"
    fi
    if [ "$_skip_token" -eq 1 ]; then
      break
    fi
    _built="$_built $(shell_quote_word "$_token")"
  done
  printf '%s' "$_built"
}

trim_line() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

read_desktop_recipe() {
  _feature_file=$1
  awk '
    in_fence && /^```[[:space:]]*$/ { in_fence = 0; closed = 1; next }
    in_fence { print; next }
    /^## Driving it with control-omairc[[:space:]]*$/ { section = 1; next }
    /^## / { if (section) section = 0; next }
    section && /^```desktop-recipe[[:space:]]*$/ { in_fence = 1; found = 1; next }
    END {
      if (!found || !closed)
        exit 3
    }
  ' "$_feature_file"
}

# Reject only Qt-offscreen verbs while loading a fence. Pointer verbs run
# through the XI2/XTEST click path (mousemove --sync + xdotool --window 0).
reject_offscreen_recipe_line() {
  _verb=$(printf '%s' "$1" | awk '{ print $1; exit }')
  case $_verb in
    qml-suite|doctor-qml)
      die "desktop recipe cannot run '$_verb': it is Qt-only (offscreen QML suite)"
      ;;
  esac
}

load_recipe_commands() {
  _feature=$1
  case $_feature in
    *[!A-Za-z0-9_-]*|"") die "invalid feature id '$_feature'" ;;
  esac
  _file=$SCRIPT_DIR/../verify-omairc/features/$_feature.md
  [ -f "$_file" ] || die "no feature file for '$_feature'"
  if ! _recipe=$(read_desktop_recipe "$_file"); then
    die "no desktop-recipe fence in $_file. Put it under ## Driving it with control-omairc, before ## Gotchas."
  fi
  _commands=$(mktemp)
  _raw=$(mktemp)
  printf '%s\n' "$_recipe" > "$_raw"
  while IFS= read -r _line || [ -n "$_line" ]; do
    _trimmed=$(trim_line "$_line")
    [ -n "$_trimmed" ] || continue
    case $_trimmed in
      \#*) continue ;;
    esac
    reject_offscreen_recipe_line "$_trimmed"
    if ! _quoted=$(shell_quote_line "$_trimmed"); then
      rm -f "$_commands" "$_raw"
      exit 1
    fi
    eval "set -- $_quoted"
    [ $# -gt 0 ] || die "empty command in desktop recipe: $_trimmed"
    case $1 in
      qml-suite|doctor-qml)
        die "desktop recipe cannot run '$1': it is Qt-only (offscreen QML suite)"
        ;;
    esac
    printf '%s\n' "$_trimmed" >> "$_commands"
  done < "$_raw"
  rm -f "$_raw"
  if [ ! -s "$_commands" ]; then
    rm -f "$_commands"
    die "desktop-recipe fence is empty in $_file"
  fi
  RECIPE_COMMANDS=$_commands
  RECIPE_FILE=$_file
}

# Skip launch when doctor is already healthy and DEMO matches.
# Exit non-zero on a healthy instance in the other mode. Do not clean it up.
# Return 0 to skip, 1 to launch.
launch_should_skip() {
  # Match demo mode only. --visible is a human watch opt-in and is not part of
  # desktop-recipe fences; a healthy instance in either xserver mode is reused.
  _want_demo=
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --demo-server) _want_demo=1; shift ;;
      --visible) shift ;;
      *) die "unknown launch argument: $1. Use launch [--demo-server] [--visible]." ;;
    esac
  done
  if ! _doctor=$("$SELF" doctor 2>/dev/null); then
    return 1
  fi
  _running=$(printf '%s\n' "$_doctor" | awk -F= '/^demo=/{ print $2; exit }')
  if [ "$_want_demo" = 1 ]; then
    if [ "$_running" != yes ]; then
      die "isolated instance is already running without --demo-server. Refusing to cleanup a healthy instance."
    fi
  else
    if [ "$_running" != no ]; then
      die "isolated instance is already running with --demo-server. Refusing to cleanup a healthy instance."
    fi
  fi
  echo "launch skipped; isolated instance already matches" >&2
  return 0
}

cmd_run() {
  _feature=
  _dry=0
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) _dry=1; shift ;;
      -*) die "unknown run argument: $1" ;;
      *)
        [ -z "$_feature" ] || die "unexpected argument: $1"
        _feature=$1
        shift
        ;;
    esac
  done
  [ -n "$_feature" ] || die "run requires a feature id"
  load_recipe_commands "$_feature"
  if [ "$_dry" -eq 1 ]; then
    cat "$RECIPE_COMMANDS"
    rm -f "$RECIPE_COMMANDS"
    return 0
  fi

  cd "$ROOT"
  _shots=$(mktemp)
  while IFS= read -r _line || [ -n "$_line" ]; do
    if ! _quoted=$(shell_quote_line "$_line"); then
      exit 1
    fi
    eval "set -- $_quoted"
    [ $# -gt 0 ] || die "empty command in desktop recipe: $_line"
    if [ "$1" = launch ] && launch_should_skip "$@"; then
      continue
    fi
    if [ "$1" = screenshot ]; then
      set +e
      _path=$("$SELF" "$@")
      _status=$?
      set -e
      [ "$_status" -eq 0 ] || exit "$_status"
      [ -n "$_path" ] || die "screenshot printed an empty path"
      [ -s "$_path" ] || die "screenshot missing or empty: $_path"
      printf '%s\n' "$_path"
      printf '%s\n' "$_path" >> "$_shots"
    else
      "$SELF" "$@"
    fi
  done < "$RECIPE_COMMANDS"

  while IFS= read -r _path || [ -n "$_path" ]; do
    [ -n "$_path" ] || die "screenshot path is empty"
    [ -s "$_path" ] || die "screenshot missing or empty: $_path"
  done < "$_shots"
  rm -f "$RECIPE_COMMANDS" "$_shots"
}

cmd=${1:-}
if [ -n "$cmd" ]; then
  shift
fi

case $cmd in
  launch) cmd_launch "$@" ;;
  doctor) cmd_doctor ;;
  title) cmd_title ;;
  wait-title) cmd_wait_title "$@" ;;
  click) cmd_click "$@" ;;
  click-conversation) cmd_click_conversation "$@" ;;
  click-member) cmd_click_member "$@" ;;
  click-people) cmd_click_people "$@" ;;
  click-network) cmd_click_network ;;
  click-edit) cmd_click_edit ;;
  click-version) cmd_click_version ;;
  click-send) cmd_click_send ;;
  focus-composer) cmd_focus_composer ;;
  composer) cmd_composer "$@" ;;
  jump) cmd_jump "$@" ;;
  walk) cmd_walk "$@" ;;
  unread) cmd_unread "$@" ;;
  toggle-members) cmd_toggle_members "$@" ;;
  focus-members) cmd_focus_members "$@" ;;
  nick-jump) cmd_nick_jump "$@" ;;
  status) cmd_status "$@" ;;
  connect) cmd_connect "$@" ;;
  type) cmd_type "$@" ;;
  key) cmd_key "$@" ;;
  send) cmd_send "$@" ;;
  screenshot) cmd_screenshot "$@" ;;
  compare) cmd_compare "$@" ;;
  run) cmd_run "$@" ;;
  qml-suite) cmd_qml_suite ;;
  doctor-qml) cmd_doctor_qml ;;
  self-check) cmd_self_check ;;
  cleanup) cmd_cleanup ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command '$cmd'. Try --help." ;;
esac
