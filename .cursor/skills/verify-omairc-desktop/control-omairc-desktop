#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"
SELF=$SCRIPT_DIR/$(basename -- "$0")
STATE_FILE="${OMAIRC_VERIFY_DESKTOP_STATE:-${TMPDIR:-/tmp}/omairc-verify-desktop-$USER/state}"
EVIDENCE_DIR="${OMAIRC_VERIFY_DESKTOP_EVIDENCE:-$ROOT/test-artifacts/verify-desktop}"
# Default debug. bin/test-desktop sets release + product to match PKGBUILD.
DESKTOP_PROFILE="${OMAIRC_DESKTOP_PROFILE:-debug}"
case $DESKTOP_PROFILE in
  debug|release) ;;
  *)
    echo "control-omairc-desktop: OMAIRC_DESKTOP_PROFILE must be debug or release (got $DESKTOP_PROFILE)" >&2
    exit 1
    ;;
esac
DESKTOP_FEATURES="${OMAIRC_DESKTOP_FEATURES:-}"
# Jump, nick-jump, and composer focus need a pause after the chord before
# type. The chord's own pause is not always enough on this Xvfb.
JUMP_FIELD_DELAY=0.4
# import can return a flat Xvfb frame before GPUI has painted, or fail and
# leave the previous PNG in place. Drop that destination before each grab
# and retry. Near-solid means a non-finite or tiny standard deviation, or
# very few colors. File size is not the test: a sparse painted window can
# be a small PNG.
SCREENSHOT_GRAB_ATTEMPTS=5
SCREENSHOT_GRAB_DELAY=0.3
SCREENSHOT_FLAT_STDDEV=0.005
SCREENSHOT_FLAT_COLORS=16
# wait-title polls the X11 window name. Cold demo launch can briefly show an
# unfocused attention preview (author: body - Omairc) until the window is
# focused and the seed settles; three seconds was flaking full recipe replay.
WAIT_TITLE_POLL_SEC=0.1
WAIT_TITLE_MAX_SEC=3600
WAIT_TITLE_DEFAULT_SEC=10
# Headless Xvfb framebuffer. --visible overrides these after reading the
# host scale so the nested size matches the physical Xephyr window (on a
# 2x panel, logical 1600x1000 → nested 3200x2000).
NESTED_WIDTH=1600
NESTED_HEIGHT=1000
# Logical size of the Xephyr window on the desktop (Hyprland layout px).
VISIBLE_LOGICAL_WIDTH=1600
VISIBLE_LOGICAL_HEIGHT=1000
VISIBLE_TITLE="Omairc verify"

usage() {
  cat <<'EOF'
control-omairc-desktop - isolated driver for the Rust GPUI Omairc desktop client

Usage:
  control-omairc-desktop launch [--demo-server] [--visible]
  control-omairc-desktop doctor
  control-omairc-desktop title
  control-omairc-desktop wait-title --exact "<title>" [--timeout SEC|10s] (max 3600)
  control-omairc-desktop focus-composer
  control-omairc-desktop composer
  control-omairc-desktop jump --query "<text>"
  control-omairc-desktop walk --down|--up [--times N]
  control-omairc-desktop unread
  control-omairc-desktop toggle-members
  control-omairc-desktop focus-members
  control-omairc-desktop nick-jump --query "<text>"
  control-omairc-desktop status
  control-omairc-desktop connect
  control-omairc-desktop type --text "<text>"
  control-omairc-desktop key --key <xdotool-key>
  control-omairc-desktop send --text "<text>"
  control-omairc-desktop click --x N --y N
  control-omairc-desktop click-conversation --name <#channel|nick>
  control-omairc-desktop click-member --name <nick>
  control-omairc-desktop click-people [--hidden]
  control-omairc-desktop click-network
  control-omairc-desktop click-edit
  control-omairc-desktop click-version
  control-omairc-desktop click-send
  control-omairc-desktop screenshot --feature <id> --name <stem>
  control-omairc-desktop compare --before <path> --after <path>
  control-omairc-desktop run <feature> [--dry-run]
  control-omairc-desktop self-check
  control-omairc-desktop cleanup

self-check uses a private OMAIRC_VERIFY_DESKTOP_STATE temp file so it never
clears the default state file for a live verify session.

Default launch uses headless Xvfb (what agents should use). --visible uses
Xephyr so a nested window appears on your desktop; same xdotool control
path. Do not put --visible in feature recipes.

Keyboard-first. Pointer verbs move with xdotool --sync mousemove, then
click through the Virtual core XTEST pointer (xinput + xdotool --window 0)
so GPUI sees XI2 ButtonPress. Do not use xdotool click --window WID:
that is XSendEvent/core and GPUI drops it. qml-suite / doctor-qml are
Qt-only. Requires lavapipe (vulkan-swrast) for Blade on the nested X
server. Never point xdotool at the user's interactive display.
EOF
}

die() {
  echo "control-omairc-desktop: $*" >&2
  exit 1
}

# First lavapipe ICD on disk, or empty. Blade needs a software Vulkan driver
# under Xvfb (no GPU). Prefer an explicit ICD over the host's NVIDIA/Intel.
# OMAIRC_LAVAPIPE_ICD overrides discovery (absolute path to an lvp ICD JSON).
find_lavapipe_icd() {
  if [ -n "${OMAIRC_LAVAPIPE_ICD:-}" ] && [ -f "$OMAIRC_LAVAPIPE_ICD" ]; then
    printf '%s' "$OMAIRC_LAVAPIPE_ICD"
    return 0
  fi
  for candidate in \
    /usr/share/vulkan/icd.d/lvp_icd.x86_64.json \
    /usr/share/vulkan/icd.d/lvp_icd.json \
    /usr/local/share/vulkan/icd.d/lvp_icd.x86_64.json \
    /usr/local/share/vulkan/icd.d/lvp_icd.json
  do
    if [ -f "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  # shellcheck disable=SC2012
  ls /usr/share/vulkan/icd.d/lvp_icd*.json 2>/dev/null | head -1 || true
}

require_lavapipe() {
  LAVAPIPE_ICD=$(find_lavapipe_icd)
  [ -n "$LAVAPIPE_ICD" ] || die "missing lavapipe ICD (software Vulkan). On Arch/Omarchy install: vulkan-swrast. Xvfb has no GPU; Blade cannot open a surface without it."
}

require_tools() {
  # $1 = visible (1) or empty. Xephyr is only required for --visible.
  _want_visible=${1:-}
  missing=
  for command_name in xauth xdotool xinput import magick cargo; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      missing="$missing $command_name"
    fi
  done
  if [ "$_want_visible" = 1 ]; then
    if ! command -v Xephyr >/dev/null 2>&1; then
      missing="$missing Xephyr"
    fi
  elif ! command -v Xvfb >/dev/null 2>&1; then
    missing="$missing Xvfb"
  fi
  if [ -n "$missing" ]; then
    if [ "$_want_visible" = 1 ]; then
      die "missing desktop tools:$missing. On Arch/Omarchy install: xorg-server-xephyr xorg-xauth xdotool xorg-xinput imagemagick rust"
    fi
    die "missing desktop tools:$missing. On Arch/Omarchy install: xorg-server-xvfb xorg-xauth xdotool xorg-xinput imagemagick rust"
  fi
  require_lavapipe
}

load_state() {
  [ -f "$STATE_FILE" ] || die "no active instance. Run: $SCRIPT_DIR/control-omairc-desktop launch [--demo-server]"
  # shellcheck disable=SC1090
  . "$STATE_FILE"
  [ -n "${DISPLAY:-}" ] || die "state file is missing DISPLAY"
  [ -n "${XAUTHORITY:-}" ] || die "state file is missing XAUTHORITY"
  [ -n "${APP_PID:-}" ] || die "state file is missing APP_PID"
  [ -n "${XVFB_PID:-}" ] || die "state file is missing XVFB_PID"
  [ -n "${WINDOW:-}" ] || die "state file is missing WINDOW"
  export DISPLAY XAUTHORITY
  if [ -n "${STATE_DIR:-}" ]; then
    export XDG_CONFIG_HOME="$STATE_DIR/config"
    export XDG_CACHE_HOME="$STATE_DIR/cache"
    export XDG_DATA_HOME="$STATE_DIR/data"
    export XDG_STATE_HOME="$STATE_DIR/state"
  fi
}

write_state() {
  mkdir -p "$(dirname -- "$STATE_FILE")"
  cat > "$STATE_FILE" <<EOF
ROOT=$ROOT
STATE_DIR=$STATE_DIR
EVIDENCE_DIR=$EVIDENCE_DIR
DISPLAY=$DISPLAY
XAUTHORITY=$XAUTHORITY
XVFB_PID=$XVFB_PID
APP_PID=$APP_PID
WINDOW=$WINDOW
BINARY=$BINARY
DEMO=$DEMO
VISIBLE=$VISIBLE
XSERVER=$XSERVER
LAVAPIPE_ICD=$LAVAPIPE_ICD
MEMBERS_OPEN=${MEMBERS_OPEN:-1}
EOF
}

process_alive() {
  kill -0 "$1" 2>/dev/null
}

stop_pid() {
  pid=$1
  if [ -n "$pid" ] && process_alive "$pid"; then
    kill "$pid"
    wait "$pid" 2>/dev/null || true
  fi
}

# Stop only the nested server and temp dir from a launch that never wrote state.
abort_isolated_launch() {
  if [ -n "${APP_PID:-}" ]; then
    stop_pid "$APP_PID"
  fi
  if [ -n "${XVFB_PID:-}" ]; then
    stop_pid "$XVFB_PID"
  fi
  if [ -n "${STATE_DIR:-}" ] && [ -d "$STATE_DIR" ]; then
    rm -rf -- "$STATE_DIR"
  fi
}

# Member panel geometry at text scale 1.0 (`client/src/ui/members/`).
MEMBER_FIRST_ROW_Y=71
MEMBER_ROW_STEP=43

conversation_y() {
  case $1 in
    "#desktop") echo 124 ;;
    "#help") echo 160 ;;
    "#omarchy") echo 196 ;;
    "#ricing") echo 232 ;;
    anna) echo 276 ;;
    dax) echo 312 ;;
    *) die "unknown conversation '$1'. Use #desktop, #help, #omarchy, #ricing, anna, or dax." ;;
  esac
}

member_row_y() {
  echo $(( MEMBER_FIRST_ROW_Y + $1 * MEMBER_ROW_STEP ))
}

# Channel half of a window title (`#desktop - Omairc`, `#omarchy · … - Omairc`).
channel_target_from_title() {
  _title=$1
  case $_title in
    "#"*)
      _rest=${_title#"#"}
      _name=${_rest%% ·*}
      _name=${_name%% - Omairc*}
      printf '#%s' "$_name"
      ;;
    *)
      return 1
      ;;
  esac
}

# Demo seed member order for one channel (`ordered_members` / PREFIX then nick).
member_index_in_demo_channel() {
  _channel=$1
  _nick=$2
  _list=
  case $_channel in
    "#omarchy")
      _list="fred anna dax mira kai teo ivy lena max nora sam sol"
      ;;
    "#desktop")
      _list="anna dax fred kai mira nora sol teo"
      ;;
    "#help")
      _list="anna dax fred mira sol"
      ;;
    "#ricing")
      _list="anna dax fred kai mira nora sol teo lena sam"
      ;;
    *)
      return 1
      ;;
  esac
  _index=0
  for _member in $_list; do
    if [ "$_member" = "$_nick" ]; then
      echo "$_index"
      return 0
    fi
    _index=$((_index + 1))
  done
  return 1
}

# Prints the member-row Y for the nick on the channel shown in the window title.
member_row_y_for_nick() {
  _nick=$1
  require_app_window
  if ! _title=$(read_window_title); then
    echo "control-omairc-desktop: click-member: cannot read window title" >&2
    return 1
  fi
  if ! _target=$(channel_target_from_title "$_title"); then
    echo "control-omairc-desktop: click-member needs a channel with the member panel open (title '$_title')" >&2
    return 1
  fi
  if ! _index=$(member_index_in_demo_channel "$_target" "$_nick"); then
    echo "control-omairc-desktop: click-member: '$_nick' is not in $_target" >&2
    return 1
  fi
  member_row_y "$_index"
}

# XTEST pointer id from xinput, or empty. GPUI on X11 only handles XI2
# ButtonPress; the Virtual core XTEST pointer is what bare XTEST clicks use.
xtest_pointer_id() {
  xinput list --id-only "Virtual core XTEST pointer" 2>/dev/null | head -1 || true
}

# Move with xdotool (window-relative), then click via XTEST (--window 0).
# Never pass the app window to click: that uses XSendEvent/core events GPUI drops.
click_xy() {
  x=$1
  y=$2
  xtest_id=$(xtest_pointer_id)
  [ -n "$xtest_id" ] || die "missing Virtual core XTEST pointer (xinput list). GPUI needs XI2 clicks through XTEST."
  xdotool windowfocus --sync "$WINDOW"
  xdotool mousemove --sync --window "$WINDOW" "$x" "$y"
  # --window 0 forces XTEST even if a prior search left a window on the stack.
  xdotool click --window 0 1
  sleep 0.2
}

# Host placement for a VISIBLE_LOGICAL_* window.
# Prints: "NESTED_W NESTED_H LOGIC_X LOGIC_Y SCALE" or nothing.
# NESTED_* is physical (logical × scale) so Xephyr matches the XWayland
# buffer; SCALE is passed to the client as --scale so fonts match HiDPI.
visible_host_placement() {
  if ! command -v hyprctl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    return 1
  fi
  WIDTH="$VISIBLE_LOGICAL_WIDTH" HEIGHT="$VISIBLE_LOGICAL_HEIGHT" python3 - <<'PY'
import json, os, subprocess

width = int(os.environ["WIDTH"])
height = int(os.environ["HEIGHT"])

def hypr(args):
    return subprocess.check_output(["hyprctl", *args], text=True)

monitors = json.loads(hypr(["monitors", "-j"]))
mon = next((m for m in monitors if m.get("focused")), monitors[0])
scale = float(mon.get("scale") or 1) or 1
lw = int(mon["width"] / scale)
lh = int(mon["height"] / scale)
reserved = mon.get("reserved") or [0, 0, 0, 0]
top = int(reserved[1]) if len(reserved) > 1 else 0
x = max(0, (lw - width) // 2)
usable = lh - top
y = top if usable < height else top + (usable - height) // 2
nested_w = max(width, int(round(width * scale)))
nested_h = max(height, int(round(height * scale)))
print(f"{nested_w} {nested_h} {x} {y} {scale:g}")
PY
}

# Place the Xephyr host window centered under the Omarchy top bar.
# Nested framebuffer already matches physical pixels (logical * scale), so
# we only float + move — do not resize the host larger than Xephyr's root
# (that left the client as a small corner inside a black frame).
place_visible_host_window() {
  _host_display=$1
  _host_xauth=$2
  _xephyr_pid=$3
  _logic_x=$4
  _logic_y=$5
  (
    export DISPLAY="$_host_display"
    if [ -n "$_host_xauth" ]; then
      export XAUTHORITY="$_host_xauth"
    else
      unset XAUTHORITY
    fi

    _win=
    _attempt=0
    while [ -z "$_win" ] && [ "$_attempt" -lt 40 ]; do
      _win=$(xdotool search --name "$VISIBLE_TITLE" 2>/dev/null | head -1 || true)
      [ -n "$_win" ] || _win=$(xdotool search --pid "$_xephyr_pid" 2>/dev/null | head -1 || true)
      _attempt=$((_attempt + 1))
      [ -n "$_win" ] || sleep 0.1
    done
    [ -n "$_win" ] || return 0

    _attempt=0
    while [ "$_attempt" -lt 8 ]; do
      xdotool windowactivate --sync "$_win" 2>/dev/null || true
      sleep 0.05
      if command -v hyprctl >/dev/null 2>&1; then
        hyprctl dispatch "hl.dsp.window.float()" >/dev/null 2>&1 || true
        # Keep native size (nested = physical). Only move to the logical origin.
        hyprctl dispatch "hl.dsp.window.move({ x = $_logic_x, y = $_logic_y })" >/dev/null 2>&1 || true
        _got=$(hyprctl clients -j 2>/dev/null | TITLE="$VISIBLE_TITLE" PID="$_xephyr_pid" \
          X="$_logic_x" Y="$_logic_y" W="$VISIBLE_LOGICAL_WIDTH" H="$VISIBLE_LOGICAL_HEIGHT" python3 - <<'PY'
import json, os, sys
title, pid = os.environ["TITLE"], int(os.environ["PID"])
x, y = int(os.environ["X"]), int(os.environ["Y"])
w, h = int(os.environ["W"]), int(os.environ["H"])
for c in json.load(sys.stdin):
    if c.get("title") == title or c.get("pid") == pid:
        at = c.get("at") or [0, 0]
        size = c.get("size") or [0, 0]
        if abs(at[0] - x) <= 4 and abs(at[1] - y) <= 4 and size[0] >= w - 2 and size[1] >= h - 2:
            print("ok")
        else:
            print(f"at={at} size={size}")
        break
PY
        ) || true
        if [ "$_got" = ok ]; then
          return 0
        fi
      fi
      # Physical xdotool fallback (logical * scale for HiDPI XWayland).
      _scale_int=$((NESTED_WIDTH / VISIBLE_LOGICAL_WIDTH))
      [ "$_scale_int" -ge 1 ] || _scale_int=1
      xdotool windowmove "$_win" "$((_logic_x * _scale_int))" "$((_logic_y * _scale_int))" 2>/dev/null || true
      _attempt=$((_attempt + 1))
      sleep 0.15
    done
  )
}


refresh_app_window() {
  found="$(xdotool search --onlyvisible --pid "$APP_PID" 2>/dev/null | head -1 || true)"
  if [ -n "$found" ]; then
    WINDOW=$found
  fi
}

require_app_alive() {
  process_alive "$APP_PID" || die "Omairc pid $APP_PID is not running"
}

require_app_window() {
  require_app_alive
  refresh_app_window
  [ -n "$WINDOW" ] || die "Omairc window is gone for pid $APP_PID"
}

window_title() {
  read_window_title
}

# Read the X11 window name. Fails when the app/window is gone; returns 1 when
# xdotool fails or the title is still empty (caller polls until deadline).
read_window_title() {
  require_app_window
  if [ -n "${SELF_CHECK_FORCE_EMPTY_TITLE:-}" ]; then
    return 1
  fi
  if ! _title=$(xdotool getwindowname "$WINDOW" 2>/dev/null); then
    return 1
  fi
  if [ -z "$_title" ]; then
    return 1
  fi
  printf '%s' "$_title"
}

report_read_window_title_failure() {
  require_app_alive
  refresh_app_window
  found="$(xdotool search --onlyvisible --pid "$APP_PID" 2>/dev/null | head -1 || true)"
  if [ -z "$found" ]; then
    die "Omairc window not found for pid $APP_PID"
  fi
  die "cannot read window title"
}

try_focus_window() {
  require_app_window
  xdotool windowfocus --sync "$WINDOW" >/dev/null 2>&1
}

now_ms() {
  _t=$(date +%s%3N 2>/dev/null) || _t=$(($(date +%s) * 1000))
  printf '%s' "$_t"
}

deadline_ms() {
  _timeout_sec=$1
  echo $(( $(now_ms) + _timeout_sec * 1000 ))
}

deadline_reached() {
  [ "$(now_ms)" -ge "$1" ]
}

invalid_wait_title_timeout() {
  if [ -n "${1:-}" ]; then
    die "invalid wait-title timeout '$1' (use seconds or 10s, max ${WAIT_TITLE_MAX_SEC})"
  fi
  die "invalid wait-title timeout (use seconds or 10s, max ${WAIT_TITLE_MAX_SEC})"
}

invalid_env_wait_title_timeout() {
  if [ -n "${1:-}" ]; then
    die "invalid OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT '$1' (use seconds or 10s, max ${WAIT_TITLE_MAX_SEC})"
  fi
  die "invalid OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT (use seconds or 10s, max ${WAIT_TITLE_MAX_SEC})"
}

# _label is "flag" for --timeout or "env" for OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT.
_wait_title_timeout_seconds() {
  _arg=$1
  _label=$2
  _invalid() {
    if [ "$_label" = env ]; then
      invalid_env_wait_title_timeout "$_arg"
    else
      invalid_wait_title_timeout "$_arg"
    fi
  }
  [ -n "$_arg" ] || _invalid
  case $_arg in
    *m*) _invalid ;;
  esac
  case $_arg in
    *s)
      _digits=${_arg%s}
      case $_digits in
        ''|*[!0-9]*) _invalid ;;
      esac
      _raw=$_digits
      ;;
    *[!0-9]*)
      _invalid
      ;;
    *)
      _raw=$_arg
      ;;
  esac
  if [ "${#_raw}" -gt 4 ]; then
    _invalid
  fi
  _sec=$(printf '%s' "$_raw" | awk '{ if ($0 !~ /^[0-9]+$/) exit 1; print $0 + 0 }') \
    || _invalid
  if [ "$_sec" -lt 1 ] || [ "$_sec" -gt "$WAIT_TITLE_MAX_SEC" ]; then
    _invalid
  fi
  echo "$_sec"
}

validate_wait_title_timeout() {
  _wait_title_timeout_seconds "$1" flag
}

wait_title_timeout_from_env() {
  if [ -z "${OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT+x}" ] || [ -z "$OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT" ]; then
    echo "$WAIT_TITLE_DEFAULT_SEC"
    return 0
  fi
  _wait_title_timeout_seconds "$OMAIRC_VERIFY_WAIT_TITLE_TIMEOUT" env
}

ensure_window_focused() {
  _timeout=$(wait_title_timeout_from_env)
  _deadline=$(deadline_ms "$_timeout")
  while ! deadline_reached "$_deadline"; do
    require_app_window
    if try_focus_window; then
      return 0
    fi
    sleep "$WAIT_TITLE_POLL_SEC"
  done
  die "failed to focus Omairc window $WINDOW within ${_timeout}s"
}

# Unfocused demo traffic uses attention_title (nick: preview - Omairc). Channel
# and DM conversation titles do not use that author: body prefix.
title_is_attention_mark() {
  case $1 in
    *" - Omairc") ;;
    *) return 1 ;;
  esac
  case $1 in
    "#"*) return 1 ;;
    *": "*) ;;
    *) return 1 ;;
  esac
  return 0
}

wait_title_mark_cleared() {
  _timeout_sec=$1
  _deadline=$(deadline_ms "$_timeout_sec")
  while ! deadline_reached "$_deadline"; do
    require_app_window
    if ! try_focus_window; then
      sleep "$WAIT_TITLE_POLL_SEC"
      continue
    fi
    if ! _title=$(read_window_title); then
      sleep "$WAIT_TITLE_POLL_SEC"
      continue
    fi
    if ! title_is_attention_mark "$_title"; then
      return 0
    fi
    sleep "$WAIT_TITLE_POLL_SEC"
  done
  require_app_window
  if ! _title=$(read_window_title); then
    die "window title empty for ${_timeout_sec}s after launch"
  fi
  if title_is_attention_mark "$_title"; then
    die "window title stayed on attention preview '$_title' for ${_timeout_sec}s after focus"
  fi
  die "failed to settle window title within ${_timeout_sec}s (last title '$_title')"
}

poll_window_title_exact() {
  _exact=$1
  _timeout_sec=$2
  _deadline=$(deadline_ms "$_timeout_sec")
  while ! deadline_reached "$_deadline"; do
    require_app_window
    if ! try_focus_window; then
      sleep "$WAIT_TITLE_POLL_SEC"
      continue
    fi
    if ! _title=$(read_window_title); then
      sleep "$WAIT_TITLE_POLL_SEC"
      continue
    fi
    if [ "$_title" = "$_exact" ]; then
      printf '%s\n' "$_title"
      return 0
    fi
    sleep "$WAIT_TITLE_POLL_SEC"
  done
  require_app_window
  if ! _title=$(read_window_title); then
    die "expected title '$_exact', window title empty after ${_timeout_sec}s"
  fi
  die "expected title '$_exact', got '$_title' after ${_timeout_sec}s"
}


cmd_launch() {
  DEMO=
  VISIBLE=
  while [ $# -gt 0 ]; do
    case $1 in
      --demo-server) DEMO=1; shift ;;
      --visible) VISIBLE=1; shift ;;
      *) die "unknown launch argument: $1. Use launch [--demo-server] [--visible]." ;;
    esac
  done

  LAUNCH_WAIT_TITLE_TIMEOUT=
  if [ "$DEMO" = 1 ]; then
    LAUNCH_WAIT_TITLE_TIMEOUT=$(wait_title_timeout_from_env)
  fi

  require_tools "$VISIBLE"
  VISIBLE_LOGIC_X=80
  VISIBLE_LOGIC_Y=40
  HOST_SCALE=
  if [ "$VISIBLE" = 1 ]; then
    # Xephyr paints a window on the caller's session. Keep that DISPLAY
    # (usually XWayland on Omarchy) before we point at the nested server.
    HOST_DISPLAY="${DISPLAY:-}"
    HOST_XAUTHORITY="${XAUTHORITY:-}"
    [ -n "$HOST_DISPLAY" ] || die "--visible needs a host DISPLAY (XWayland) so Xephyr can show a window on your desktop"
    # Nested framebuffer = physical host window (logical × scale). Pass the
    # same scale to the client so text is not 1x inside a 2x buffer.
    _place=$(visible_host_placement) || _place=
    if [ -n "$_place" ]; then
      set -- $_place
      NESTED_WIDTH=$1
      NESTED_HEIGHT=$2
      VISIBLE_LOGIC_X=$3
      VISIBLE_LOGIC_Y=$4
      HOST_SCALE=$5
    fi
  fi
  if [ -f "$STATE_FILE" ]; then
    if "$SELF" doctor >/dev/null 2>&1; then
      die "an isolated Omairc instance is already running. Run cleanup first, or doctor to inspect it."
    fi
    echo "control-omairc-desktop: clearing stale run state" >&2
    cmd_cleanup >/dev/null 2>&1 || true
  fi

  set -- build
  if [ -n "${OMAIRC_VERIFY_DESKTOP_BINARY:-}" ]; then
    BINARY="$OMAIRC_VERIFY_DESKTOP_BINARY"
  else
    if [ "$DESKTOP_PROFILE" = release ]; then
      set -- "$@" --release
    fi
    if [ -n "$DESKTOP_FEATURES" ]; then
      set -- "$@" --features "$DESKTOP_FEATURES"
    fi
    (cd "$ROOT/client" && cargo "$@")
    BINARY="$ROOT/client/target/$DESKTOP_PROFILE/omairc"
  fi
  [ -x "$BINARY" ] || die "missing $BINARY after cargo build ($DESKTOP_PROFILE)"

  STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/omairc-verify-desktop.XXXXXX")"
  display_number=110
  while [ -e "/tmp/.X11-unix/X$display_number" ]; do
    display_number=$((display_number + 1))
  done
  NESTED_DISPLAY=":$display_number"
  NESTED_XAUTHORITY="$STATE_DIR/Xauthority"
  cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  xauth -f "$NESTED_XAUTHORITY" add "$NESTED_DISPLAY" . "$cookie"

  mkdir -p "$EVIDENCE_DIR" "$STATE_DIR/logs"
  if [ "$VISIBLE" = 1 ]; then
    XSERVER=Xephyr
    # Host DISPLAY opens the nested window on your desktop (XWayland on
    # Omarchy). App and xdotool use NESTED_DISPLAY only. Physical origin
    # is a hint; place_visible_host_window moves to the logical center.
    _phys_x=$((VISIBLE_LOGIC_X * NESTED_WIDTH / VISIBLE_LOGICAL_WIDTH))
    _phys_y=$((VISIBLE_LOGIC_Y * NESTED_HEIGHT / VISIBLE_LOGICAL_HEIGHT))
    (
      export DISPLAY="$HOST_DISPLAY"
      if [ -n "$HOST_XAUTHORITY" ]; then
        export XAUTHORITY="$HOST_XAUTHORITY"
      else
        unset XAUTHORITY
      fi
      unset WAYLAND_DISPLAY
      unset WAYLAND_SOCKET
      exec Xephyr "$NESTED_DISPLAY" \
        -screen "${NESTED_WIDTH}x${NESTED_HEIGHT}+${_phys_x}+${_phys_y}x24" \
        -nolisten tcp -auth "$NESTED_XAUTHORITY" -title "$VISIBLE_TITLE"
    ) >"$STATE_DIR/logs/xserver.log" 2>&1 &
    XVFB_PID=$!
  else
    XSERVER=Xvfb
    Xvfb "$NESTED_DISPLAY" -screen 0 "${NESTED_WIDTH}x${NESTED_HEIGHT}x24" -nolisten tcp \
      -auth "$NESTED_XAUTHORITY" \
      >"$STATE_DIR/logs/xserver.log" 2>&1 &
    XVFB_PID=$!
  fi

  DISPLAY="$NESTED_DISPLAY"
  XAUTHORITY="$NESTED_XAUTHORITY"
  export DISPLAY XAUTHORITY

  attempt=0
  while ! xdotool getmouselocation >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! process_alive "$XVFB_PID"; then
      if [ -f "$STATE_DIR/logs/xserver.log" ]; then
        echo "control-omairc-desktop: xserver.log:" >&2
        cat "$STATE_DIR/logs/xserver.log" >&2 || true
      fi
      abort_isolated_launch
      die "isolated X server ($XSERVER) did not start"
    fi
    sleep 0.1
  done

  export XDG_CONFIG_HOME="$STATE_DIR/config"
  export XDG_CACHE_HOME="$STATE_DIR/cache"
  export XDG_DATA_HOME="$STATE_DIR/data"
  export XDG_STATE_HOME="$STATE_DIR/state"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$STATE_DIR/no-session-bus"
  # GPUI prefers Wayland whenever WAYLAND_DISPLAY is set. Clear it so the
  # window opens on the nested X server, where xdotool can see it.
  unset WAYLAND_DISPLAY
  unset WAYLAND_SOCKET
  export XDG_SESSION_TYPE=x11
  # Force lavapipe: a host NVIDIA/Intel ICD cannot present on Xvfb/Xephyr.
  export VK_ICD_FILENAMES="$LAVAPIPE_ICD"
  export OMAIRC_ALLOW_MULTI=1
  set -- "$BINARY"
  if [ "$DEMO" = 1 ]; then
    set -- "$@" --demo-server
  fi
  if [ -n "$HOST_SCALE" ]; then
    set -- "$@" --scale "$HOST_SCALE"
  fi
  # Cold lavapipe + GPUI first map often needs more than a few seconds on CI
  # runners after a fresh cargo build; five seconds was flaking the first recipe.
  # GPUI can also lose the race against a just-started Xvfb ("Failed to
  # initialize X11 client"); retry the binary against the same nested server.
  launch_try=0
  WINDOW=
  while [ -z "$WINDOW" ]; do
    launch_try=$((launch_try + 1))
    : >"$STATE_DIR/logs/omairc.log"
    "$@" >"$STATE_DIR/logs/omairc.log" 2>&1 &
    APP_PID=$!

    attempt=0
    while [ -z "$WINDOW" ]; do
      WINDOW="$(xdotool search --onlyvisible --pid "$APP_PID" 2>/dev/null | head -1 || true)"
      attempt=$((attempt + 1))
      if [ -n "$WINDOW" ]; then
        break
      fi
      if [ "$attempt" -ge 150 ]; then
        break
      fi
      if ! process_alive "$APP_PID"; then
        break
      fi
      sleep 0.1
    done

    if [ -n "$WINDOW" ]; then
      break
    fi
    if process_alive "$APP_PID"; then
      kill "$APP_PID" 2>/dev/null || true
      wait "$APP_PID" 2>/dev/null || true
    fi
    if [ "$launch_try" -lt 3 ] \
      && grep -Fq 'Failed to initialize X11 client' "$STATE_DIR/logs/omairc.log" 2>/dev/null \
      && process_alive "$XVFB_PID"; then
      echo "control-omairc-desktop: X11 client init failed; retrying launch ($launch_try/3)" >&2
      sleep 0.2
      continue
    fi
    if [ -f "$STATE_DIR/logs/omairc.log" ]; then
      echo "control-omairc-desktop: omairc.log:" >&2
      cat "$STATE_DIR/logs/omairc.log" >&2 || true
    fi
    abort_isolated_launch
    die "Omairc did not open; see $STATE_DIR/logs/omairc.log"
  done

  # Place after the app maps so the Xephyr host window is fully on-screen.
  # Grow the Omairc window to fill the nested framebuffer (default 1180x760).
  if [ "$VISIBLE" = 1 ]; then
    place_visible_host_window "$HOST_DISPLAY" "$HOST_XAUTHORITY" "$XVFB_PID" \
      "$VISIBLE_LOGIC_X" "$VISIBLE_LOGIC_Y"
    xdotool windowmove --sync "$WINDOW" 0 0
    xdotool windowsize --sync "$WINDOW" "$NESTED_WIDTH" "$NESTED_HEIGHT"
  fi

  # Demo channels start with the member panel open (Shell::members_open).
  MEMBERS_OPEN=1
  write_state
  if [ "$DEMO" = 1 ]; then
    wait_title_mark_cleared "$LAUNCH_WAIT_TITLE_TIMEOUT"
  else
    ensure_window_focused
  fi
  echo "launched isolated Omairc"
  if [ "$DEMO" = 1 ]; then
    echo "demo=yes"
  else
    echo "demo=no"
  fi
  if [ "$VISIBLE" = 1 ]; then
    echo "visible=yes"
  else
    echo "visible=no"
  fi
  if [ -n "$HOST_SCALE" ]; then
    echo "scale=$HOST_SCALE"
  fi
  echo "xserver=$XSERVER"
  echo "display=$DISPLAY"
  echo "pid=$APP_PID"
  echo "window=$WINDOW"
  if ! _title=$(read_window_title); then
    die "Omairc launched but window title is empty"
  fi
  echo "title=$_title"
  echo "state=$STATE_FILE"
}

cmd_doctor() {
  load_state
