#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"
SELF=$SCRIPT_DIR/$(basename -- "$0")
STATE_FILE="${OMAIRC_VERIFY_POC_STATE:-${TMPDIR:-/tmp}/omairc-verify-poc-$USER/state}"
EVIDENCE_DIR="${OMAIRC_VERIFY_POC_EVIDENCE:-$ROOT/test-artifacts/verify-poc}"
# Jump, nick-jump, and composer focus need a pause after the chord before
# type. The chord's own pause is not always enough on this Xvfb.
JUMP_FIELD_DELAY=0.4
# import can return a flat Xvfb frame before GPUI has painted, or fail and
# leave the previous PNG in place. Drop that destination before each grab
# and retry. Near-solid means a non-finite or tiny standard deviation, or
# very few colors. File size is not the test: a sparse painted window can
# be a small PNG.
SCREENSHOT_GRAB_ATTEMPTS=5
SCREENSHOT_GRAB_DELAY=0.3
SCREENSHOT_FLAT_STDDEV=0.005
SCREENSHOT_FLAT_COLORS=16
# Headless Xvfb framebuffer. --visible overrides these after reading the
# host scale so the nested size matches the physical Xephyr window (on a
# 2x panel, logical 1600x1000 → nested 3200x2000).
NESTED_WIDTH=1600
NESTED_HEIGHT=1000
# Logical size of the Xephyr window on the desktop (Hyprland layout px).
VISIBLE_LOGICAL_WIDTH=1600
VISIBLE_LOGICAL_HEIGHT=1000
VISIBLE_TITLE="Omairc PoC verify"

usage() {
  cat <<'EOF'
control-omairc-poc - isolated driver for the Rust GPUI Omairc PoC

Usage:
  control-omairc-poc launch [--demo-server] [--visible]
  control-omairc-poc doctor
  control-omairc-poc title
  control-omairc-poc wait-title --exact "<title>"
  control-omairc-poc focus-composer
  control-omairc-poc composer
  control-omairc-poc jump --query "<text>"
  control-omairc-poc walk --down|--up [--times N]
  control-omairc-poc unread
  control-omairc-poc toggle-members
  control-omairc-poc focus-members
  control-omairc-poc nick-jump --query "<text>"
  control-omairc-poc status
  control-omairc-poc connect
  control-omairc-poc type --text "<text>"
  control-omairc-poc key --key <xdotool-key>
  control-omairc-poc send --text "<text>"
  control-omairc-poc click --x N --y N
  control-omairc-poc click-conversation --name <#channel|nick>
  control-omairc-poc click-member --name <nick>
  control-omairc-poc click-people [--hidden]
  control-omairc-poc click-network
  control-omairc-poc click-edit
  control-omairc-poc click-version
  control-omairc-poc click-send
  control-omairc-poc screenshot --feature <id> --name <stem>
  control-omairc-poc compare --before <path> --after <path>
  control-omairc-poc run <feature> [--dry-run]
  control-omairc-poc cleanup

Default launch uses headless Xvfb (what agents should use). --visible uses
Xephyr so a nested window appears on your desktop; same xdotool control
path. Do not put --visible in feature recipes.

Keyboard-first. Pointer verbs move with xdotool --sync mousemove, then
click through the Virtual core XTEST pointer (xinput + xdotool --window 0)
so GPUI sees XI2 ButtonPress. Do not use xdotool click --window WID:
that is XSendEvent/core and GPUI drops it. qml-suite / doctor-qml are
Qt-only. Requires lavapipe (vulkan-swrast) for Blade on the nested X
server. Never point xdotool at the user's interactive display.
EOF
}

die() {
  echo "control-omairc-poc: $*" >&2
  exit 1
}

# First lavapipe ICD on disk, or empty. Blade needs a software Vulkan driver
# under Xvfb (no GPU). Prefer an explicit ICD over the host's NVIDIA/Intel.
# OMAIRC_LAVAPIPE_ICD overrides discovery (absolute path to an lvp ICD JSON).
find_lavapipe_icd() {
  if [ -n "${OMAIRC_LAVAPIPE_ICD:-}" ] && [ -f "$OMAIRC_LAVAPIPE_ICD" ]; then
    printf '%s' "$OMAIRC_LAVAPIPE_ICD"
    return 0
  fi
  for candidate in \
    /usr/share/vulkan/icd.d/lvp_icd.x86_64.json \
    /usr/share/vulkan/icd.d/lvp_icd.json \
    /usr/local/share/vulkan/icd.d/lvp_icd.x86_64.json \
    /usr/local/share/vulkan/icd.d/lvp_icd.json
  do
    if [ -f "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  # shellcheck disable=SC2012
  ls /usr/share/vulkan/icd.d/lvp_icd*.json 2>/dev/null | head -1 || true
}

require_lavapipe() {
  LAVAPIPE_ICD=$(find_lavapipe_icd)
  [ -n "$LAVAPIPE_ICD" ] || die "missing lavapipe ICD (software Vulkan). On Arch/Omarchy install: vulkan-swrast. Xvfb has no GPU; Blade cannot open a surface without it."
}

require_tools() {
  # $1 = visible (1) or empty. Xephyr is only required for --visible.
  _want_visible=${1:-}
  missing=
  for command_name in xauth xdotool xinput import magick cargo; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      missing="$missing $command_name"
    fi
  done
  if [ "$_want_visible" = 1 ]; then
    if ! command -v Xephyr >/dev/null 2>&1; then
      missing="$missing Xephyr"
    fi
  elif ! command -v Xvfb >/dev/null 2>&1; then
    missing="$missing Xvfb"
  fi
  if [ -n "$missing" ]; then
    if [ "$_want_visible" = 1 ]; then
      die "missing desktop tools:$missing. On Arch/Omarchy install: xorg-server-xephyr xorg-xauth xdotool xorg-xinput imagemagick rust"
    fi
    die "missing desktop tools:$missing. On Arch/Omarchy install: xorg-server-xvfb xorg-xauth xdotool xorg-xinput imagemagick rust"
  fi
  require_lavapipe
}

load_state() {
  [ -f "$STATE_FILE" ] || die "no active instance. Run: $SCRIPT_DIR/control-omairc-poc launch [--demo-server]"
  # shellcheck disable=SC1090
  . "$STATE_FILE"
  [ -n "${DISPLAY:-}" ] || die "state file is missing DISPLAY"
  [ -n "${XAUTHORITY:-}" ] || die "state file is missing XAUTHORITY"
  [ -n "${APP_PID:-}" ] || die "state file is missing APP_PID"
  [ -n "${XVFB_PID:-}" ] || die "state file is missing XVFB_PID"
  [ -n "${WINDOW:-}" ] || die "state file is missing WINDOW"
  export DISPLAY XAUTHORITY
}

write_state() {
  mkdir -p "$(dirname -- "$STATE_FILE")"
  cat > "$STATE_FILE" <<EOF
ROOT=$ROOT
STATE_DIR=$STATE_DIR
EVIDENCE_DIR=$EVIDENCE_DIR
DISPLAY=$DISPLAY
XAUTHORITY=$XAUTHORITY
XVFB_PID=$XVFB_PID
APP_PID=$APP_PID
WINDOW=$WINDOW
BINARY=$BINARY
DEMO=$DEMO
VISIBLE=$VISIBLE
XSERVER=$XSERVER
LAVAPIPE_ICD=$LAVAPIPE_ICD
MEMBERS_OPEN=${MEMBERS_OPEN:-1}
EOF
}

process_alive() {
  kill -0 "$1" 2>/dev/null
}

stop_pid() {
  pid=$1
  if [ -n "$pid" ] && process_alive "$pid"; then
    kill "$pid"
    wait "$pid" 2>/dev/null || true
  fi
}

conversation_y() {
  case $1 in
    "#desktop") echo 124 ;;
    "#help") echo 160 ;;
    "#omarchy") echo 196 ;;
    "#ricing") echo 232 ;;
    anna) echo 276 ;;
    dax) echo 312 ;;
    *) die "unknown conversation '$1'. Use #desktop, #help, #omarchy, #ricing, anna, or dax." ;;
  esac
}

member_y() {
  # Rows are ordered by server PREFIX rank, highest first, then nick
  # (IrcEventReducer::orderedMembers). Seeded #omarchy settles as:
  # ~fred, &anna, @dax, @mira, %kai, +teo, ivy, lena, max, nora, sam, sol.
  case $1 in
    fred) echo 71 ;;
    anna) echo 114 ;;
    dax) echo 157 ;;
    mira) echo 200 ;;
    kai) echo 243 ;;
    teo) echo 286 ;;
    ivy) echo 329 ;;
    lena) echo 372 ;;
    max) echo 415 ;;
    nora) echo 458 ;;
    sam) echo 501 ;;
    sol) echo 544 ;;
    *) die "unknown member '$1'." ;;
  esac
}

# XTEST pointer id from xinput, or empty. GPUI on X11 only handles XI2
# ButtonPress; the Virtual core XTEST pointer is what bare XTEST clicks use.
xtest_pointer_id() {
  xinput list --id-only "Virtual core XTEST pointer" 2>/dev/null | head -1 || true
}

# Move with xdotool (window-relative), then click via XTEST (--window 0).
# Never pass the app window to click: that uses XSendEvent/core events GPUI drops.
click_xy() {
  x=$1
  y=$2
  xtest_id=$(xtest_pointer_id)
  [ -n "$xtest_id" ] || die "missing Virtual core XTEST pointer (xinput list). GPUI needs XI2 clicks through XTEST."
  xdotool windowfocus --sync "$WINDOW"
  xdotool mousemove --sync --window "$WINDOW" "$x" "$y"
  # --window 0 forces XTEST even if a prior search left a window on the stack.
  xdotool click --window 0 1
  sleep 0.2
}

# Host placement for a VISIBLE_LOGICAL_* window.
# Prints: "NESTED_W NESTED_H LOGIC_X LOGIC_Y SCALE" or nothing.
# NESTED_* is physical (logical × scale) so Xephyr matches the XWayland
# buffer; SCALE is passed to the PoC as --scale so fonts match HiDPI.
visible_host_placement() {
  if ! command -v hyprctl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    return 1
  fi
  WIDTH="$VISIBLE_LOGICAL_WIDTH" HEIGHT="$VISIBLE_LOGICAL_HEIGHT" python3 - <<'PY'
import json, os, subprocess

width = int(os.environ["WIDTH"])
height = int(os.environ["HEIGHT"])

def hypr(args):
    return subprocess.check_output(["hyprctl", *args], text=True)

monitors = json.loads(hypr(["monitors", "-j"]))
mon = next((m for m in monitors if m.get("focused")), monitors[0])
scale = float(mon.get("scale") or 1) or 1
lw = int(mon["width"] / scale)
lh = int(mon["height"] / scale)
reserved = mon.get("reserved") or [0, 0, 0, 0]
top = int(reserved[1]) if len(reserved) > 1 else 0
x = max(0, (lw - width) // 2)
usable = lh - top
y = top if usable < height else top + (usable - height) // 2
nested_w = max(width, int(round(width * scale)))
nested_h = max(height, int(round(height * scale)))
print(f"{nested_w} {nested_h} {x} {y} {scale:g}")
PY
}

# Place the Xephyr host window centered under the Omarchy top bar.
# Nested framebuffer already matches physical pixels (logical * scale), so
# we only float + move — do not resize the host larger than Xephyr's root
# (that left the client as a small corner inside a black frame).
place_visible_host_window() {
  _host_display=$1
  _host_xauth=$2
  _xephyr_pid=$3
  _logic_x=$4
  _logic_y=$5
  (
    export DISPLAY="$_host_display"
    if [ -n "$_host_xauth" ]; then
      export XAUTHORITY="$_host_xauth"
    else
      unset XAUTHORITY
    fi

    _win=
    _attempt=0
    while [ -z "$_win" ] && [ "$_attempt" -lt 40 ]; do
      _win=$(xdotool search --name "$VISIBLE_TITLE" 2>/dev/null | head -1 || true)
      [ -n "$_win" ] || _win=$(xdotool search --pid "$_xephyr_pid" 2>/dev/null | head -1 || true)
      _attempt=$((_attempt + 1))
      [ -n "$_win" ] || sleep 0.1
    done
    [ -n "$_win" ] || return 0

    _attempt=0
    while [ "$_attempt" -lt 8 ]; do
      xdotool windowactivate --sync "$_win" 2>/dev/null || true
      sleep 0.05
      if command -v hyprctl >/dev/null 2>&1; then
        hyprctl dispatch "hl.dsp.window.float()" >/dev/null 2>&1 || true
        # Keep native size (nested = physical). Only move to the logical origin.
        hyprctl dispatch "hl.dsp.window.move({ x = $_logic_x, y = $_logic_y })" >/dev/null 2>&1 || true
        _got=$(hyprctl clients -j 2>/dev/null | TITLE="$VISIBLE_TITLE" PID="$_xephyr_pid" \
          X="$_logic_x" Y="$_logic_y" W="$VISIBLE_LOGICAL_WIDTH" H="$VISIBLE_LOGICAL_HEIGHT" python3 - <<'PY'
import json, os, sys
title, pid = os.environ["TITLE"], int(os.environ["PID"])
x, y = int(os.environ["X"]), int(os.environ["Y"])
w, h = int(os.environ["W"]), int(os.environ["H"])
for c in json.load(sys.stdin):
    if c.get("title") == title or c.get("pid") == pid:
        at = c.get("at") or [0, 0]
        size = c.get("size") or [0, 0]
        if abs(at[0] - x) <= 4 and abs(at[1] - y) <= 4 and size[0] >= w - 2 and size[1] >= h - 2:
            print("ok")
        else:
            print(f"at={at} size={size}")
        break
PY
        ) || true
        if [ "$_got" = ok ]; then
          return 0
        fi
      fi
      # Physical xdotool fallback (logical * scale for HiDPI XWayland).
      _scale_int=$((NESTED_WIDTH / VISIBLE_LOGICAL_WIDTH))
      [ "$_scale_int" -ge 1 ] || _scale_int=1
      xdotool windowmove "$_win" "$((_logic_x * _scale_int))" "$((_logic_y * _scale_int))" 2>/dev/null || true
      _attempt=$((_attempt + 1))
      sleep 0.15
    done
  )
}


window_title() {
  xdotool getwindowname "$WINDOW"
}


cmd_launch() {
  DEMO=
  VISIBLE=
  while [ $# -gt 0 ]; do
    case $1 in
      --demo-server) DEMO=1; shift ;;
      --visible) VISIBLE=1; shift ;;
      *) die "unknown launch argument: $1. Use launch [--demo-server] [--visible]." ;;
    esac
  done

  require_tools "$VISIBLE"
  VISIBLE_LOGIC_X=80
  VISIBLE_LOGIC_Y=40
  HOST_SCALE=
  if [ "$VISIBLE" = 1 ]; then
    # Xephyr paints a window on the caller's session. Keep that DISPLAY
    # (usually XWayland on Omarchy) before we point at the nested server.
    HOST_DISPLAY="${DISPLAY:-}"
    HOST_XAUTHORITY="${XAUTHORITY:-}"
    [ -n "$HOST_DISPLAY" ] || die "--visible needs a host DISPLAY (XWayland) so Xephyr can show a window on your desktop"
    # Nested framebuffer = physical host window (logical × scale). Pass the
    # same scale to the PoC so text is not 1x inside a 2x buffer.
    _place=$(visible_host_placement) || _place=
    if [ -n "$_place" ]; then
      set -- $_place
      NESTED_WIDTH=$1
      NESTED_HEIGHT=$2
      VISIBLE_LOGIC_X=$3
      VISIBLE_LOGIC_Y=$4
      HOST_SCALE=$5
    fi
  fi
  if [ -f "$STATE_FILE" ]; then
    if "$SELF" doctor >/dev/null 2>&1; then
      die "an isolated PoC instance is already running. Run cleanup first, or doctor to inspect it."
    fi
    echo "control-omairc-poc: clearing stale run state" >&2
    cmd_cleanup >/dev/null 2>&1 || true
  fi

  (cd "$ROOT/poc" && cargo build)
  STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/omairc-verify-poc.XXXXXX")"
  BINARY="$ROOT/poc/target/debug/omairc"
  [ -x "$BINARY" ] || die "missing $BINARY after cargo build"

  display_number=110
  while [ -e "/tmp/.X11-unix/X$display_number" ]; do
    display_number=$((display_number + 1))
  done
  NESTED_DISPLAY=":$display_number"
  NESTED_XAUTHORITY="$STATE_DIR/Xauthority"
  cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  xauth -f "$NESTED_XAUTHORITY" add "$NESTED_DISPLAY" . "$cookie"

  mkdir -p "$EVIDENCE_DIR" "$STATE_DIR/logs"
  if [ "$VISIBLE" = 1 ]; then
    XSERVER=Xephyr
    # Host DISPLAY opens the nested window on your desktop (XWayland on
    # Omarchy). App and xdotool use NESTED_DISPLAY only. Physical origin
    # is a hint; place_visible_host_window moves to the logical center.
    _phys_x=$((VISIBLE_LOGIC_X * NESTED_WIDTH / VISIBLE_LOGICAL_WIDTH))
    _phys_y=$((VISIBLE_LOGIC_Y * NESTED_HEIGHT / VISIBLE_LOGICAL_HEIGHT))
    (
      export DISPLAY="$HOST_DISPLAY"
      if [ -n "$HOST_XAUTHORITY" ]; then
        export XAUTHORITY="$HOST_XAUTHORITY"
      else
        unset XAUTHORITY
      fi
      unset WAYLAND_DISPLAY
      unset WAYLAND_SOCKET
      exec Xephyr "$NESTED_DISPLAY" \
        -screen "${NESTED_WIDTH}x${NESTED_HEIGHT}+${_phys_x}+${_phys_y}x24" \
        -nolisten tcp -auth "$NESTED_XAUTHORITY" -title "$VISIBLE_TITLE"
    ) >"$STATE_DIR/logs/xserver.log" 2>&1 &
    XVFB_PID=$!
  else
    XSERVER=Xvfb
    Xvfb "$NESTED_DISPLAY" -screen 0 "${NESTED_WIDTH}x${NESTED_HEIGHT}x24" -nolisten tcp \
      -auth "$NESTED_XAUTHORITY" \
      >"$STATE_DIR/logs/xserver.log" 2>&1 &
    XVFB_PID=$!
  fi

  DISPLAY="$NESTED_DISPLAY"
  XAUTHORITY="$NESTED_XAUTHORITY"
  export DISPLAY XAUTHORITY

  attempt=0
  while ! xdotool getmouselocation >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! process_alive "$XVFB_PID"; then
      die "isolated X server ($XSERVER) did not start; see $STATE_DIR/logs/xserver.log"
    fi
    sleep 0.1
  done

  export XDG_CONFIG_HOME="$STATE_DIR/config"
  export XDG_CACHE_HOME="$STATE_DIR/cache"
  export XDG_DATA_HOME="$STATE_DIR/data"
  export XDG_STATE_HOME="$STATE_DIR/state"
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$STATE_DIR/no-session-bus"
  # GPUI prefers Wayland whenever WAYLAND_DISPLAY is set. Clear it so the
  # window opens on the nested X server, where xdotool can see it.
  unset WAYLAND_DISPLAY
  unset WAYLAND_SOCKET
  export XDG_SESSION_TYPE=x11
  # Force lavapipe: a host NVIDIA/Intel ICD cannot present on Xvfb/Xephyr.
  export VK_ICD_FILENAMES="$LAVAPIPE_ICD"
  export OMAIRC_ALLOW_MULTI=1
  set -- "$BINARY"
  if [ "$DEMO" = 1 ]; then
    set -- "$@" --demo-server
  fi
  if [ -n "$HOST_SCALE" ]; then
    set -- "$@" --scale "$HOST_SCALE"
  fi
  "$@" >"$STATE_DIR/logs/omairc.log" 2>&1 &
  APP_PID=$!

  attempt=0
  WINDOW=
  while [ -z "$WINDOW" ]; do
    WINDOW="$(xdotool search --onlyvisible --pid "$APP_PID" 2>/dev/null | head -1 || true)"
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! process_alive "$APP_PID"; then
      die "Omairc PoC did not open; see $STATE_DIR/logs/omairc.log"
    fi
    sleep 0.1
  done

  # Place after the app maps so the Xephyr host window is fully on-screen.
  # Grow the PoC window to fill the nested framebuffer (default 1180x760).
  if [ "$VISIBLE" = 1 ]; then
    place_visible_host_window "$HOST_DISPLAY" "$HOST_XAUTHORITY" "$XVFB_PID" \
      "$VISIBLE_LOGIC_X" "$VISIBLE_LOGIC_Y"
    xdotool windowmove --sync "$WINDOW" 0 0
    xdotool windowsize --sync "$WINDOW" "$NESTED_WIDTH" "$NESTED_HEIGHT"
  fi

  # Demo channels start with the member panel open (Shell::members_open).
  MEMBERS_OPEN=1
  write_state
  xdotool windowfocus --sync "$WINDOW"
  echo "launched isolated Omairc PoC"
  if [ "$DEMO" = 1 ]; then
    echo "demo=yes"
  else
    echo "demo=no"
  fi
  if [ "$VISIBLE" = 1 ]; then
    echo "visible=yes"
  else
    echo "visible=no"
  fi
  if [ -n "$HOST_SCALE" ]; then
    echo "scale=$HOST_SCALE"
  fi
  echo "xserver=$XSERVER"
  echo "display=$DISPLAY"
  echo "pid=$APP_PID"
  echo "window=$WINDOW"
  echo "title=$(window_title)"
  echo "state=$STATE_FILE"
}

cmd_doctor() {
  load_state
  process_alive "$XVFB_PID" || die "X server pid $XVFB_PID is not running"
  process_alive "$APP_PID" || die "Omairc PoC pid $APP_PID is not running"
  [ -x "$BINARY" ] || die "binary missing: $BINARY"
  [ -e "/tmp/.X11-unix/X${DISPLAY#:}" ] || die "display $DISPLAY is gone"
  found="$(xdotool search --onlyvisible --pid "$APP_PID" 2>/dev/null | head -1 || true)"
  [ "$found" = "$WINDOW" ] || die "window $WINDOW is not the Omairc PoC window for pid $APP_PID"
  title="$(window_title)"
  case $title in
    *" - Omairc"|*" Status"|Status) ;;
    *) die "unexpected window title '$title'" ;;
  esac
  case $BINARY in
    */poc/target/debug/omairc|*/poc/target/release/omairc) ;;
    *) die "binary is not the desktop binary: $BINARY" ;;
  esac
  require_lavapipe
  echo "ok isolated Omairc PoC"
  echo "binary=$BINARY"
  echo "display=$DISPLAY"
  echo "app_pid=$APP_PID"
  echo "xserver_pid=$XVFB_PID"
  echo "xserver=${XSERVER:-Xvfb}"
  echo "window=$WINDOW"
  echo "title=$title"
  echo "xdg=$STATE_DIR"
  echo "evidence=$EVIDENCE_DIR"
  echo "lavapipe=$LAVAPIPE_ICD"
  if [ "${DEMO:-}" = 1 ]; then
    echo "demo=yes"
  else
    echo "demo=no"
  fi
  if [ "${VISIBLE:-}" = 1 ]; then
    echo "visible=yes"
  else
    echo "visible=no"
  fi
}

cmd_title() {
  load_state
  window_title
}

cmd_wait_title() {
  exact=
  while [ $# -gt 0 ]; do
    case $1 in
      --exact) exact=$2; shift 2 ;;
      *) die "unknown wait-title argument: $1" ;;
    esac
  done
  [ -n "$exact" ] || die "wait-title requires --exact"
  load_state
  attempt=0
  while [ "$(window_title)" != "$exact" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
      die "expected title '$exact', got '$(window_title)'"
    fi
    sleep 0.1
  done
  window_title
}


reject_qt_only_verb() {
  die "verb '$1' is Qt-only (offscreen QML suite). Use control-omairc for that path."
}

cmd_click() {
  x=
  y=
  while [ $# -gt 0 ]; do
    case $1 in
      --x) x=$2; shift 2 ;;
      --y) y=$2; shift 2 ;;
      *) die "unknown click argument: $1" ;;
    esac
  done
  [ -n "$x" ] && [ -n "$y" ] || die "click requires --x and --y"
  load_state
  click_xy "$x" "$y"
}

cmd_click_conversation() {
  name=
  while [ $# -gt 0 ]; do
    case $1 in
      --name) name=$2; shift 2 ;;
      *) die "unknown click-conversation argument: $1" ;;
    esac
  done
  [ -n "$name" ] || die "click-conversation requires --name"
  load_state
  click_xy 120 "$(conversation_y "$name")"
}

cmd_click_member() {
  name=
  while [ $# -gt 0 ]; do
    case $1 in
      --name) name=$2; shift 2 ;;
      *) die "unknown click-member argument: $1" ;;
    esac
  done
  [ -n "$name" ] || die "click-member requires --name"
  load_state
  click_xy 1070 "$(member_y "$name")"
}

cmd_click_people() {
  hidden=
  while [ $# -gt 0 ]; do
    case $1 in
      --hidden) hidden=1; shift ;;
      *) die "unknown click-people argument: $1. Use click-people or click-people --hidden." ;;
    esac
  done
  load_state
  # Same 1180-wide layout as control-omairc / Qt. The people control is
  # right-anchored; the member column is 216 CSS px.
  if [ "$hidden" = 1 ]; then
    click_xy 1124 36
  else
    click_xy 908 36
  fi
}

cmd_click_network() {
  load_state
  click_xy 120 36
}

