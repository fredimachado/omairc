# Print "stddev colors" or nothing when magick cannot read the file.
screenshot_metrics() {
  magick "$1" -format '%[fx:standard_deviation] %k' info: 2>/dev/null || true
}

# Missing, empty, unreadable, or near-solid. ImageMagick 6 prints "-nan"
# for a low-variance frame. mawk treats that token as ordered, so match
# nan/inf as text before the numeric test. A flat frame is also one color,
# a handful of colors, or a field whose spread is ~0.
screenshot_is_near_solid() {
  _path=$1
  [ -s "$_path" ] || return 0
  _stats=$(screenshot_metrics "$_path")
  [ -n "$_stats" ] || return 0
  _std=$(printf '%s\n' "$_stats" | awk '{ print $1; exit }')
  _colors=$(printf '%s\n' "$_stats" | awk '{ print $2; exit }')
  awk -v std="$_std" -v colors="$_colors" \
    -v max_std="$SCREENSHOT_FLAT_STDDEV" -v max_colors="$SCREENSHOT_FLAT_COLORS" \
    'BEGIN {
      token = tolower(std "")
      sub(/^[+-]/, "", token)
      if (token ~ /^(nan|inf)/)
        exit 0
      std += 0
      colors += 0
      max_std += 0
      max_colors += 0
      if (std != std || std < max_std || colors < max_colors)
        exit 0
      exit 1
    }'
}

cmd_screenshot() {
  feature=
  name=
  while [ $# -gt 0 ]; do
    case $1 in
      --feature) feature=$2; shift 2 ;;
      --name) name=$2; shift 2 ;;
      *) die "unknown screenshot argument: $1" ;;
    esac
  done
  [ -n "$feature" ] && [ -n "$name" ] || die "screenshot requires --feature and --name"
  load_state
  dest="$EVIDENCE_DIR/$feature"
  mkdir -p "$dest"
  path="$dest/$name.png"
  _attempt=1
  while :; do
    # A failed import must not classify the previous PNG as this grab.
    rm -f -- "$path"
    if import -display "$DISPLAY" -window "$WINDOW" "$path"; then
      if ! screenshot_is_near_solid "$path"; then
        echo "$path"
        return 0
      fi
    else
      rm -f -- "$path"
    fi
    [ "$_attempt" -lt "$SCREENSHOT_GRAB_ATTEMPTS" ] || break
    _attempt=$((_attempt + 1))
    sleep "$SCREENSHOT_GRAB_DELAY"
  done
  # Latest grab failed, or it succeeded and is still near-solid.
  _stats=$(screenshot_metrics "$path")
  die "screenshot is missing, empty, or still a flat frame: $path${_stats:+ ($_stats)}"
}

remap_verify_path() {
  # Shared desktop-recipe fences write test-artifacts/verify/; this driver
  # keeps evidence under test-artifacts/verify-poc/.
  case $1 in
    test-artifacts/verify/*)
      printf 'test-artifacts/verify-poc/%s' "${1#test-artifacts/verify/}"
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

cmd_compare() {
  before=
  after=
  while [ $# -gt 0 ]; do
    case $1 in
      --before) before=$2; shift 2 ;;
      --after) after=$2; shift 2 ;;
      *) die "unknown compare argument: $1" ;;
    esac
  done
  [ -n "$before" ] && [ -n "$after" ] || die "compare requires --before and --after"
  before=$(remap_verify_path "$before")
  after=$(remap_verify_path "$after")
  [ -s "$before" ] || die "missing before image: $before"
  [ -s "$after" ] || die "missing after image: $after"
  difference="$(magick compare -metric AE "$before" "$after" null: 2>&1 || true)"
  ae="$(printf '%s\n' "$difference" | awk '{ print $1; exit }')"
  if ! awk -v ae="$ae" 'BEGIN { exit !(ae + 0 > 100) }'; then
    die "expected a visible UI change between $before and $after (AE=$difference)"
  fi
  echo "changed AE=$ae"
}

cmd_doctor_qml() { reject_qt_only_verb doctor-qml; }
cmd_qml_suite() { reject_qt_only_verb qml-suite; }

cmd_cleanup() {
  if [ -f "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    stop_pid "${APP_PID:-}"
    stop_pid "${XVFB_PID:-}"
    if [ -n "${STATE_DIR:-}" ] && [ -d "$STATE_DIR" ]; then
      rm -rf -- "$STATE_DIR"
    fi
    rm -f -- "$STATE_FILE"
  fi
  echo "cleaned isolated instance"
  echo "evidence kept at $EVIDENCE_DIR"
}

# Print one eval-safe word. Single quotes keep "#desktop" from becoming a comment.
shell_quote_word() {
  _word=$1
  _escaped=$(printf '%s' "$_word" | sed "s/'/'\\\\''/g")
  printf "'%s'" "$_escaped"
}

# Print the recipe line as eval-safe words for `eval "set -- ..."`.
# Unbalanced quotes exit 1 after a message. A trailing unquoted # is a comment.
shell_quote_line() {
  _rest=$1
  _built=
  while :; do
    while :; do
      case $_rest in
        "") break 2 ;;
        " "*) _rest=${_rest# } ;;
        "	"*) _rest=${_rest#	} ;;
        *) break ;;
      esac
    done
    case $_rest in
      \#*) break ;;
    esac
    _token=
    _mode=none
    _skip_token=0
    while [ -n "$_rest" ]; do
      _char=${_rest%"${_rest#?}"}
      _rest=${_rest#?}
      case $_mode in
        none)
          case $_char in
            " "|"	") break ;;
            "'") _mode=single ;;
            '"') _mode=double ;;
            \#)
              if [ -z "$_token" ]; then
                _skip_token=1
                _rest=
              else
                _token=$_token$_char
              fi
              ;;
            *) _token=$_token$_char ;;
          esac
          ;;
        single)
          case $_char in
            "'") _mode=none ;;
            *) _token=$_token$_char ;;
          esac
          ;;
        double)
          case $_char in
            '"') _mode=none ;;
            *) _token=$_token$_char ;;
          esac
          ;;
      esac
    done
    if [ "$_mode" != none ]; then
      die "unbalanced quotes in desktop recipe"
    fi
    if [ "$_skip_token" -eq 1 ]; then
      break
    fi
    _built="$_built $(shell_quote_word "$_token")"
  done
  printf '%s' "$_built"
}

trim_line() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

read_desktop_recipe() {
  _feature_file=$1
  awk '
    in_fence && /^```[[:space:]]*$/ { in_fence = 0; closed = 1; next }
    in_fence { print; next }
    /^## Driving it with control-omairc[[:space:]]*$/ { section = 1; next }
    /^## / { if (section) section = 0; next }
    section && /^```desktop-recipe[[:space:]]*$/ { in_fence = 1; found = 1; next }
    END {
      if (!found || !closed)
        exit 3
    }
  ' "$_feature_file"
}

# Reject only Qt-offscreen verbs while loading a fence. Pointer verbs run
# through the XI2/XTEST click path (mousemove --sync + xdotool --window 0).
reject_offscreen_recipe_line() {
  _verb=$(printf '%s' "$1" | awk '{ print $1; exit }')
  case $_verb in
    qml-suite|doctor-qml)
      die "desktop recipe cannot run '$_verb': it is Qt-only (offscreen QML suite)"
      ;;
  esac
}

load_recipe_commands() {
  _feature=$1
  case $_feature in
    *[!A-Za-z0-9_-]*|"") die "invalid feature id '$_feature'" ;;
  esac
  _file=$SCRIPT_DIR/../verify-omairc/features/$_feature.md
  [ -f "$_file" ] || die "no feature file for '$_feature'"
  if ! _recipe=$(read_desktop_recipe "$_file"); then
    die "no desktop-recipe fence in $_file. Put it under ## Driving it with control-omairc, before ## Gotchas."
  fi
  _commands=$(mktemp)
  _raw=$(mktemp)
  printf '%s\n' "$_recipe" > "$_raw"
  while IFS= read -r _line || [ -n "$_line" ]; do
    _trimmed=$(trim_line "$_line")
    [ -n "$_trimmed" ] || continue
    case $_trimmed in
      \#*) continue ;;
    esac
    reject_offscreen_recipe_line "$_trimmed"
    if ! _quoted=$(shell_quote_line "$_trimmed"); then
      rm -f "$_commands" "$_raw"
      exit 1
    fi
    eval "set -- $_quoted"
    [ $# -gt 0 ] || die "empty command in desktop recipe: $_trimmed"
    case $1 in
      qml-suite|doctor-qml)
        die "desktop recipe cannot run '$1': it is Qt-only (offscreen QML suite)"
        ;;
    esac
    printf '%s\n' "$_trimmed" >> "$_commands"
  done < "$_raw"
  rm -f "$_raw"
  if [ ! -s "$_commands" ]; then
    rm -f "$_commands"
    die "desktop-recipe fence is empty in $_file"
  fi
  RECIPE_COMMANDS=$_commands
  RECIPE_FILE=$_file
}

# Skip launch when doctor is already healthy and DEMO matches.
# Exit non-zero on a healthy instance in the other mode. Do not clean it up.
# Return 0 to skip, 1 to launch.
launch_should_skip() {
  # Match demo mode only. --visible is a human watch opt-in and is not part of
  # desktop-recipe fences; a healthy instance in either xserver mode is reused.
  _want_demo=
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --demo-server) _want_demo=1; shift ;;
      --visible) shift ;;
      *) die "unknown launch argument: $1. Use launch [--demo-server] [--visible]." ;;
    esac
  done
  if ! _doctor=$("$SELF" doctor 2>/dev/null); then
    return 1
  fi
  _running=$(printf '%s\n' "$_doctor" | awk -F= '/^demo=/{ print $2; exit }')
  if [ "$_want_demo" = 1 ]; then
    if [ "$_running" != yes ]; then
      die "isolated instance is already running without --demo-server. Refusing to cleanup a healthy instance."
    fi
  else
    if [ "$_running" != no ]; then
      die "isolated instance is already running with --demo-server. Refusing to cleanup a healthy instance."
    fi
  fi
  echo "launch skipped; isolated instance already matches" >&2
  return 0
}

cmd_run() {
  _feature=
  _dry=0
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) _dry=1; shift ;;
      -*) die "unknown run argument: $1" ;;
      *)
        [ -z "$_feature" ] || die "unexpected argument: $1"
        _feature=$1
        shift
        ;;
    esac
  done
  [ -n "$_feature" ] || die "run requires a feature id"
  load_recipe_commands "$_feature"
  if [ "$_dry" -eq 1 ]; then
    cat "$RECIPE_COMMANDS"
    rm -f "$RECIPE_COMMANDS"
    return 0
  fi

  cd "$ROOT"
  _shots=$(mktemp)
  while IFS= read -r _line || [ -n "$_line" ]; do
    if ! _quoted=$(shell_quote_line "$_line"); then
      exit 1
    fi
    eval "set -- $_quoted"
    [ $# -gt 0 ] || die "empty command in desktop recipe: $_line"
    if [ "$1" = launch ] && launch_should_skip "$@"; then
      continue
    fi
    if [ "$1" = screenshot ]; then
      set +e
      _path=$("$SELF" "$@")
      _status=$?
      set -e
      [ "$_status" -eq 0 ] || exit "$_status"
      [ -n "$_path" ] || die "screenshot printed an empty path"
      [ -s "$_path" ] || die "screenshot missing or empty: $_path"
      printf '%s\n' "$_path"
      printf '%s\n' "$_path" >> "$_shots"
    else
      "$SELF" "$@"
    fi
  done < "$RECIPE_COMMANDS"

  while IFS= read -r _path || [ -n "$_path" ]; do
    [ -n "$_path" ] || die "screenshot path is empty"
    [ -s "$_path" ] || die "screenshot missing or empty: $_path"
  done < "$_shots"
  rm -f "$RECIPE_COMMANDS" "$_shots"
}

cmd=${1:-}
if [ -n "$cmd" ]; then
  shift
fi

case $cmd in
  launch) cmd_launch "$@" ;;
  doctor) cmd_doctor ;;
  title) cmd_title ;;
  wait-title) cmd_wait_title "$@" ;;
  click) cmd_click "$@" ;;
  click-conversation) cmd_click_conversation "$@" ;;
  click-member) cmd_click_member "$@" ;;
  click-people) cmd_click_people "$@" ;;
  click-network) cmd_click_network ;;
  click-edit) cmd_click_edit ;;
  click-version) cmd_click_version ;;
  click-send) cmd_click_send ;;
  focus-composer) cmd_focus_composer ;;
  composer) cmd_composer "$@" ;;
  jump) cmd_jump "$@" ;;
  walk) cmd_walk "$@" ;;
  unread) cmd_unread "$@" ;;
  toggle-members) cmd_toggle_members "$@" ;;
  focus-members) cmd_focus_members "$@" ;;
  nick-jump) cmd_nick_jump "$@" ;;
  status) cmd_status "$@" ;;
  connect) cmd_connect "$@" ;;
  type) cmd_type "$@" ;;
  key) cmd_key "$@" ;;
  send) cmd_send "$@" ;;
  screenshot) cmd_screenshot "$@" ;;
  compare) cmd_compare "$@" ;;
  run) cmd_run "$@" ;;
  qml-suite) cmd_qml_suite ;;
