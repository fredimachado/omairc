_omairc()
{
    local cur
    cur="${COMP_WORDS[COMP_CWORD]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "connections list status send read names conversations raise help --help --version --demo-server" -- "$cur") )
        return 0
    fi

    case "${COMP_WORDS[1]}" in
        connections|list|raise)
            COMPREPLY=( $(compgen -W "--help" -- "$cur") )
            ;;
        help)
            COMPREPLY=( $(compgen -W "connections list status send read names conversations raise --help" -- "$cur") )
            ;;
        status|send|names|conversations)
            COMPREPLY=( $(compgen -W "--network --help" -- "$cur") )
            ;;
        read)
            COMPREPLY=( $(compgen -W "--network --last --since --unread --help" -- "$cur") )
            ;;
    esac
}

complete -F _omairc omairc
